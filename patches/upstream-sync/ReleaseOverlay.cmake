include("${CMAKE_CURRENT_LIST_DIR}/../lobby-restoration/ReleaseOverlay.cmake")
if(PROJECT_NAME STREQUAL "DKRRuntimePreparation")
 function(dkr_apply_upstream_sync)
  set(auth "${DKRPORT_ROOT}/patches/upstream-sync")
  set(stage "${CMAKE_BINARY_DIR}/generated/upstream-sync")
  file(TO_CMAKE_PATH "${DKR_SDK2_REUSE_STAGE}" sdk2)
  file(MAKE_DIRECTORY "${stage}")
  set(rows "[")
  set(separator "")
  foreach(pair "DKRCustomTracksCore|custom_tracks.cpp" "DKRPortGame|runtime_ui.cpp" "DKRPortGame|runtime_code_mods.cpp")
   string(REPLACE "|" ";" fields "${pair}")
   list(GET fields 0 target)
   list(GET fields 1 name)
   get_target_property(paths ${target} SOURCES)
   list(FILTER paths INCLUDE REGEX "[/\\\\]${name}$")
   list(LENGTH paths count)
   if(NOT count EQUAL 1)
    message(FATAL_ERROR "Upstream sync needs one final ${target}/${name}")
   endif()
   list(GET paths 0 path)
   file(TO_CMAKE_PATH "${path}" path)
   set(extra "")
   if(name STREQUAL "runtime_ui.cpp")
    set(extra ",\"graphics\":\"${CMAKE_BINARY_DIR}/generated/all-player-detail/all_detail_graphics.inl\",\"preset_header\":\"${sdk2}/native/src/game/mobile_graphics_preset.hpp\"")
   elseif(name STREQUAL "runtime_code_mods.cpp")
    set(extra ",\"dispatch_header\":\"${sdk2}/native/src/game/mods/magic_code_dispatch.h\"")
   endif()
   string(APPEND rows "${separator}{\"target\":\"${target}\",\"path\":\"${path}\"${extra}}")
   set(separator ",")
  endforeach()
  string(APPEND rows "]")
  file(WRITE "${stage}/inputs.json" "${rows}")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${auth}/pipeline.py" "${auth}/transforms.py" "${auth}/pins.json")
  foreach(name custom_tracks.cpp mobile_graphics_preset.hpp runtime_graphics_ui.inl runtime_code_mods.cpp mods/magic_code_dispatch.h)
   set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${DKRPORT_ROOT}/runtime-recomp/src/game/${name}")
  endforeach()
  execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${auth}/pipeline.py" --inputs "${stage}/inputs.json" --output "${stage}" RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
   message(FATAL_ERROR "Reviewed upstream sync could not stage")
  endif()
  file(READ "${stage}/swaps.json" swaps)
  string(JSON count LENGTH "${swaps}")
  math(EXPR last "${count}-1")
  foreach(index RANGE ${last})
   string(JSON target GET "${swaps}" ${index} target)
   string(JSON old GET "${swaps}" ${index} path)
   string(JSON next GET "${swaps}" ${index} new)
   get_target_property(directory ${target} SOURCE_DIR)
   foreach(property INCLUDE_DIRECTORIES COMPILE_OPTIONS COMPILE_DEFINITIONS)
    get_property(defined SOURCE "${old}" DIRECTORY "${directory}" PROPERTY ${property} SET)
    if(defined)
     get_property(value SOURCE "${old}" DIRECTORY "${directory}" PROPERTY ${property})
     set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY ${property} "${value}")
    endif()
   endforeach()
   get_filename_component(prior "${old}" DIRECTORY)
   get_property(includes SOURCE "${next}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES)
   set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES "${stage};${prior};${includes}")
   dkr_repair_replace_source(${target} "${old}" "${next}")
  endforeach()
 endfunction()
 cmake_language(DEFER CALL dkr_apply_upstream_sync)
endif()
