# Compose only a first-party graphics decoder over the accepted beta 10 saves,
# Store and SDK. Never patch a checked-out/staged dependency for this repair.
include("${CMAKE_CURRENT_LIST_DIR}/../shared-saves/NativeOverlay.cmake")
if(PROJECT_NAME STREQUAL "DKRRuntimePreparation")
    function(dkr_apply_vanilla_water_animation)
        execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${DKRPORT_ROOT}/patches/vanilla-water/pipeline.py"
            verify --output "${DKR_VANILLA_WATER_STAGE}" RESULT_VARIABLE status)
        if(NOT status EQUAL 0)
            message(FATAL_ERROR "Vanilla water animation receipt failed")
        endif()
        get_target_property(sources DKRPortGame SOURCES)
        set(replaced)
        set(count 0)
        foreach(source IN LISTS sources)
            if(source MATCHES "/f3ddkr_rt64\\.cpp$")
                math(EXPR count "${count}+1")
                set(next "${DKR_VANILLA_WATER_STAGE}/native/f3ddkr_rt64.cpp")
                foreach(property INCLUDE_DIRECTORIES COMPILE_OPTIONS COMPILE_DEFINITIONS)
                    get_property(defined SOURCE "${source}" PROPERTY ${property} SET)
                    if(defined)
                        get_property(value SOURCE "${source}" PROPERTY ${property})
                        set_property(SOURCE "${next}" PROPERTY ${property} "${value}")
                    endif()
                endforeach()
                get_filename_component(prior "${source}" DIRECTORY)
                set_property(SOURCE "${next}" APPEND PROPERTY INCLUDE_DIRECTORIES "${prior}")
                list(APPEND replaced "${next}")
            else()
                list(APPEND replaced "${source}")
            endif()
        endforeach()
        if(NOT count EQUAL 1)
            message(FATAL_ERROR "Expected exactly one first-party F3DDKR decoder")
        endif()
        set_property(TARGET DKRPortGame PROPERTY SOURCES "${replaced}")
        message(STATUS "Vanilla rivers/waterfalls: independent UV-period metadata; no optical work when disabled")
    endfunction()
    cmake_language(DEFER CALL dkr_apply_vanilla_water_animation)
endif()
