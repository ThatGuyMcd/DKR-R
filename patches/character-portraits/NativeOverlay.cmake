# Project-owned source selection only. No source or submodule is patched in
# place. All consumers see the same staged header ABI, including ModWorker.
if(PROJECT_NAME STREQUAL "DKRRuntimePreparation")
    if(NOT DKR_PORTRAIT_STAGE OR NOT EXISTS "${DKR_PORTRAIT_STAGE}/native-receipt.json")
        message(FATAL_ERROR "Portrait overlay requires a fresh, verified Patch Pipeline stage")
    endif()
    function(dkr_portrait_overlay_targets directory)
        get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
        foreach(target IN LISTS targets)
            foreach(property SOURCES INCLUDE_DIRECTORIES INTERFACE_INCLUDE_DIRECTORIES)
                get_target_property(values ${target} ${property})
                if(NOT values OR values MATCHES "-NOTFOUND$")
                    continue()
                endif()
                set(replaced)
                foreach(value IN LISTS values)
                    set(next "${value}")
                    if(property STREQUAL "SOURCES" AND NOT IS_ABSOLUTE "${value}" AND NOT value MATCHES "^\\$<")
                        get_filename_component(next "${value}" ABSOLUTE BASE_DIR "${directory}")
                    endif()
                    string(REPLACE "${DKRPORT_ROOT}/runtime-recomp/src/" "${DKR_PORTRAIT_STAGE}/src/" next "${next}")
                    if(next STREQUAL "${DKRPORT_ROOT}/runtime-recomp/src")
                        set(next "${DKR_PORTRAIT_STAGE}/src")
                    endif()
                    if(property STREQUAL "SOURCES" AND NOT next STREQUAL value AND next MATCHES "${DKR_PORTRAIT_STAGE}/src/")
                        if(NOT EXISTS "${next}")
                            message(FATAL_ERROR "Portrait stage is missing ${next}")
                        endif()
                        foreach(source_property COMPILE_OPTIONS COMPILE_DEFINITIONS INCLUDE_DIRECTORIES SKIP_PRECOMPILE_HEADERS LANGUAGE SKIP_UNITY_BUILD_INCLUSION)
                            get_property(is_set SOURCE "${value}" DIRECTORY "${directory}" PROPERTY ${source_property} SET)
                            if(is_set)
                                get_property(setting SOURCE "${value}" DIRECTORY "${directory}" PROPERTY ${source_property})
                                set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY ${source_property} "${setting}")
                            endif()
                        endforeach()
                    endif()
                    list(APPEND replaced "${next}")
                endforeach()
                set_property(TARGET ${target} PROPERTY ${property} "${replaced}")
            endforeach()
        endforeach()
        get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
        foreach(child IN LISTS children)
            # Dependency targets are deliberately not altered.
            if(child MATCHES "^${DKRPORT_ROOT}/runtime-recomp(/|$)")
                dkr_portrait_overlay_targets("${child}")
            endif()
        endforeach()
    endfunction()
    function(dkr_apply_portrait_overlay)
        find_package(Python3 REQUIRED COMPONENTS Interpreter)
        execute_process(COMMAND "${Python3_EXECUTABLE}" "${DKRPORT_ROOT}/scripts/character_portrait_pipeline.py"
            verify-native --output "${DKR_PORTRAIT_STAGE}" RESULT_VARIABLE result)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Portrait source stage failed its integrity check")
        endif()
        dkr_portrait_overlay_targets("${DKRPORT_ROOT}/runtime-recomp")
        # The project also exposes these first-party support sources through
        # RT64's link interface. Keep those paths identical to the executable's
        # direct sources so CMake deduplicates them. No dependency source,
        # private include path, compile flag or submodule file is changed.
        get_target_property(renderer_support rt64 INTERFACE_SOURCES)
        if(renderer_support AND NOT renderer_support MATCHES "-NOTFOUND$")
            string(REPLACE "${DKRPORT_ROOT}/runtime-recomp/src/" "${DKR_PORTRAIT_STAGE}/src/"
                renderer_support "${renderer_support}")
            set_property(TARGET rt64 PROPERTY INTERFACE_SOURCES "${renderer_support}")
        endif()
        message(STATUS "Character portraits: reviewed source recovery and per-participant world signs enabled")
    endfunction()
    cmake_language(DEFER CALL dkr_apply_portrait_overlay)
endif()
