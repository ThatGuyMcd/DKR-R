include("${CMAKE_CURRENT_LIST_DIR}/../offline-retention-repair/ReleaseOverlay.cmake")
if(PROJECT_NAME STREQUAL "DKRRuntimePreparation")
 function(dkr_apply_spectator_admission_repair)
  set(auth "${DKRPORT_ROOT}/patches/spectator-admission-repair")
  set(stage "${CMAKE_BINARY_DIR}/generated/spectator-admission-repair")
  file(MAKE_DIRECTORY "${stage}")
  set(rows "[")
  set(separator "")
  foreach(target DKRLegacyModLaunch DKRPortGame DKRExperimentalOwnedGameV77 DKRExperimentalOwnedGameV80)
   if(target STREQUAL "DKRLegacyModLaunch")
    set(name resident_music.cpp)
   elseif(target STREQUAL "DKRPortGame")
    set(name party_runtime.cpp)
   else()
    set(name probe_driver.cpp)
   endif()
   get_target_property(paths ${target} SOURCES)
   list(FILTER paths INCLUDE REGEX "[/\\]${name}$")
   list(LENGTH paths count)
   if(NOT count EQUAL 1)
    message(FATAL_ERROR "Spectator repair needs one final ${target}/${name}")
   endif()
   list(GET paths 0 old_${target})
   file(TO_CMAKE_PATH "${old_${target}}" old_${target})
   string(APPEND rows "${separator}{\"target\":\"${target}\",\"path\":\"${old_${target}}\"}")
   set(separator ",")
  endforeach()
  string(APPEND rows "]")
  file(WRITE "${stage}/inputs.json" "${rows}")
  file(GLOB authored CONFIGURE_DEPENDS "${auth}/native/*")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${authored}
   "${auth}/pipeline.py" "${auth}/transforms.py" "${auth}/ReleaseOverlay.cmake")
  execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${auth}/pipeline.py" --inputs "${stage}/inputs.json" --output "${stage}" RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
   message(FATAL_ERROR "Spectator admission repair could not stage")
  endif()
  foreach(target DKRLegacyModLaunch DKRPortGame DKRExperimentalOwnedGameV77 DKRExperimentalOwnedGameV80)
   set(old "${old_${target}}")
   get_filename_component(name "${old}" NAME)
   get_filename_component(prior "${old}" DIRECTORY)
   get_target_property(directory ${target} SOURCE_DIR)
   set(next "${stage}/${target}/${name}")
   foreach(property INCLUDE_DIRECTORIES COMPILE_OPTIONS COMPILE_DEFINITIONS)
    get_property(defined SOURCE "${old}" DIRECTORY "${directory}" PROPERTY ${property} SET)
    if(defined)
     get_property(value SOURCE "${old}" DIRECTORY "${directory}" PROPERTY ${property})
     set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY ${property} "${value}")
    endif()
   endforeach()
   get_property(includes SOURCE "${next}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES)
   set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES "${stage};${prior};${includes}")
   dkr_repair_replace_source(${target} "${old}" "${next}")
  endforeach()
  # The repair changes resource admission for observers only, not simulation,
  # checkpoint/wire layouts or peer identifiers. Both revisions retain .3 IDs.
  get_target_property(definitions DKRRaceReleaseChecks COMPILE_DEFINITIONS)
  list(FILTER definitions EXCLUDE REGEX "^DKR_RACE_RELEASE_SOURCE=")
  list(APPEND definitions "DKR_RACE_RELEASE_SOURCE=\"${stage}/DKRPortGame/party_runtime.cpp\"")
  set_property(TARGET DKRRaceReleaseChecks PROPERTY COMPILE_DEFINITIONS "${definitions}")
  add_executable(DKRSpectatorAdmissionChecks EXCLUDE_FROM_ALL "${auth}/tests/music_tests.cpp")
  target_compile_features(DKRSpectatorAdmissionChecks PRIVATE cxx_std_20)
  target_include_directories(DKRSpectatorAdmissionChecks PRIVATE "${stage}" "${DKRPORT_ROOT}/runtime-recomp/src/game")
  target_link_libraries(DKRSpectatorAdmissionChecks PRIVATE DKRLegacyModLaunch)
  add_executable(DKRSpectatorAdmissionBeforeChecks EXCLUDE_FROM_ALL "${auth}/tests/music_tests.cpp" "${old_DKRLegacyModLaunch}")
  target_compile_features(DKRSpectatorAdmissionBeforeChecks PRIVATE cxx_std_20)
  target_include_directories(DKRSpectatorAdmissionBeforeChecks PRIVATE "${stage}" "${DKRPORT_ROOT}/runtime-recomp/src/game")
  target_link_libraries(DKRSpectatorAdmissionBeforeChecks PRIVATE DKRLegacyModLaunch)
  add_executable(DKRSpectatorHandlerChecks EXCLUDE_FROM_ALL "${auth}/tests/handler_tests.cpp")
  target_compile_features(DKRSpectatorHandlerChecks PRIVATE cxx_std_20)
  target_compile_definitions(DKRSpectatorHandlerChecks PRIVATE "DKR_RACE_RELEASE_SOURCE=\"${stage}/DKRPortGame/party_runtime.cpp\"")
  get_target_property(handler_includes DKRRaceReleaseChecks INCLUDE_DIRECTORIES)
  target_include_directories(DKRSpectatorHandlerChecks PRIVATE "${stage}" ${handler_includes})
  target_link_libraries(DKRSpectatorHandlerChecks PRIVATE DKRNetplayCore)
  get_target_property(links DKRPortGame LINK_DIRECTORIES)
  if(links)
   target_link_directories(DKRSpectatorAdmissionChecks PRIVATE ${links})
   target_link_directories(DKRSpectatorAdmissionBeforeChecks PRIVATE ${links})
   target_link_directories(DKRSpectatorHandlerChecks PRIVATE ${links})
  endif()
 endfunction()
 cmake_language(DEFER CALL dkr_apply_spectator_admission_repair)
endif()
