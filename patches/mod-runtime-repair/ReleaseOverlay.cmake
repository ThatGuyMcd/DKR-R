# Extend the accepted vehicle/review editor; never change protected checkouts.
include("${CMAKE_CURRENT_LIST_DIR}/../custom-vehicles/ReleaseOverlay.cmake")
if(PROJECT_NAME STREQUAL "DKRRuntimePreparation")
    function(dkr_repair_replace_source target old next)
        get_target_property(sources ${target} SOURCES)
        file(TO_CMAKE_PATH "${old}" wanted)
        set(updated "")
        set(matches 0)
        foreach(path IN LISTS sources)
            file(TO_CMAKE_PATH "${path}" normalized)
            if(normalized STREQUAL wanted)
                math(EXPR matches "${matches}+1")
                list(APPEND updated "${next}")
            else()
                list(APPEND updated "${path}")
            endif()
        endforeach()
        if(NOT matches EQUAL 1)
            message(FATAL_ERROR "Repair source replacement needs one exact normalized match: ${old} (${matches})")
        endif()
        set_property(TARGET ${target} PROPERTY SOURCES "${updated}")
    endfunction()
    function(dkr_apply_mod_runtime_repair)
        set(auth "${DKRPORT_ROOT}/patches/mod-runtime-repair")
        set(stage "${CMAKE_BINARY_DIR}/generated/mod-runtime-repair")
        file(MAKE_DIRECTORY "${stage}")
        file(GLOB authored CONFIGURE_DEPENDS "${auth}/native/*")
        list(APPEND authored "${auth}/pipeline.py" "${auth}/guest_pipeline.py" "${auth}/ReleaseOverlay.cmake")
        list(SORT authored)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${authored})
        set(records "[")
        set(separator "")
        foreach(pair "DKRCustomMagicCodes|magic_code_vm.cpp" "DKRCustomMagicCodes|magic_code_world.cpp"
                "DKRCustomMagicCodes|magic_code_game_world.cpp" "DKRCustomMagicCodes|magic_code_link.cpp"
                "DKRCustomMagicCodes|magic_code_package.cpp" "DKRPortGame|presentation_identity.cpp"
                "DKRPortGame|runtime_hud_layout.cpp" "DKRPortGame|f3ddkr_rt64.cpp")
            string(REPLACE "|" ";" fields "${pair}")
            list(GET fields 0 target)
            list(GET fields 1 filename)
            get_target_property(sources ${target} SOURCES)
            set(selected ${sources})
            list(FILTER selected INCLUDE REGEX "/${filename}$")
            list(LENGTH selected count)
            if(NOT count EQUAL 1)
                message(FATAL_ERROR "Repair needs one final ${filename}")
            endif()
            list(GET selected 0 path)
            file(TO_CMAKE_PATH "${path}" path)
            string(APPEND records "${separator}{\"target\":\"${target}\",\"path\":\"${path}\"}")
            set(separator ",")
        endforeach()
        string(APPEND records "]")
        file(WRITE "${stage}/native-inputs.json" "${records}")
        execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${auth}/pipeline.py"
            --inputs "${stage}/native-inputs.json" --output "${stage}"
            --sdk "${DKR_SDK2_REUSE_STAGE}/native/src/game"
            --reference "${DKR_SDK2_REUSE_STAGE}/modding" RESULT_VARIABLE result)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Mod runtime native repair composition failed")
        endif()
        target_sources(DKRPortGame PRIVATE "${stage}/native/game/render_heap_support.cpp")
        get_target_property(game_directory DKRPortGame SOURCE_DIR)
        set_property(SOURCE "${stage}/native/game/render_heap_support.cpp" DIRECTORY "${game_directory}"
            PROPERTY INCLUDE_DIRECTORIES "${DKR_SDK2_REUSE_STAGE}/native/src/game")
        file(READ "${stage}/native-swaps.json" swaps)
        string(JSON count LENGTH "${swaps}")
        math(EXPR last "${count}-1")
        foreach(index RANGE ${last})
            string(JSON target GET "${swaps}" ${index} target)
            string(JSON old GET "${swaps}" ${index} path)
            string(JSON next GET "${swaps}" ${index} new)
            file(TO_CMAKE_PATH "${next}" next)
            get_target_property(directory ${target} SOURCE_DIR)
            foreach(property INCLUDE_DIRECTORIES COMPILE_OPTIONS COMPILE_DEFINITIONS)
                get_property(defined SOURCE "${old}" DIRECTORY "${directory}" PROPERTY ${property} SET)
                if(defined)
                    get_property(value SOURCE "${old}" DIRECTORY "${directory}" PROPERTY ${property})
                    set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY ${property} "${value}")
                endif()
            endforeach()
            get_filename_component(prior "${old}" DIRECTORY)
            get_filename_component(filename "${old}" NAME)
            get_property(includes SOURCE "${next}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES)
            set(extra "")
            if(filename MATCHES "^magic_code_")
                set(extra "${stage}/native/mods;")
            endif()
            set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES
                "${extra}${prior};${includes}")
            dkr_repair_replace_source(${target} "${old}" "${next}")
        endforeach()
        foreach(target DKRRecompiledFuncsV77 DKRRecompiledFuncsV80 DKRExperimentalOwnedGameV77 DKRExperimentalOwnedGameV80)
            get_target_property(sources ${target} SOURCES)
            set(json "[")
            set(separator "")
            foreach(path IN LISTS sources)
                if(path MATCHES "\\.c$")
                    file(TO_CMAKE_PATH "${path}" path)
                    string(APPEND json "${separator}\"${path}\"")
                    set(separator ",")
                endif()
            endforeach()
            string(APPEND json "]")
            file(WRITE "${stage}/${target}-inputs.json" "${json}")
            execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${auth}/guest_pipeline.py"
                --sources "${stage}/${target}-inputs.json" --output "${stage}/${target}"
                RESULT_VARIABLE result)
            if(NOT result EQUAL 0)
                message(FATAL_ERROR "Drawing heap repair failed for ${target}")
            endif()
            file(READ "${stage}/${target}/swaps.json" swaps)
            string(JSON old GET "${swaps}" 0 old)
            string(JSON next GET "${swaps}" 0 new)
            file(TO_CMAKE_PATH "${old}" old)
            file(TO_CMAKE_PATH "${next}" next)
            get_target_property(directory ${target} SOURCE_DIR)
            foreach(property INCLUDE_DIRECTORIES COMPILE_OPTIONS COMPILE_DEFINITIONS)
                get_property(defined SOURCE "${old}" DIRECTORY "${directory}" PROPERTY ${property} SET)
                if(defined)
                    get_property(value SOURCE "${old}" DIRECTORY "${directory}" PROPERTY ${property})
                    set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY ${property} "${value}")
                endif()
            endforeach()
            get_filename_component(prior "${old}" DIRECTORY)
            set_property(SOURCE "${next}" DIRECTORY "${directory}" APPEND PROPERTY INCLUDE_DIRECTORIES "${prior}")
            dkr_repair_replace_source(${target} "${old}" "${next}")
        endforeach()
        # Authored policy and generated guest/native repairs define the same
        # portable contract on Windows/Linux. No path/host/timestamp in it.
        set(ledger "mod-runtime-repair-v1\n")
        foreach(path IN LISTS authored)
            file(RELATIVE_PATH name "${auth}" "${path}")
            file(SHA256 "${path}" hash)
            string(APPEND ledger "${name}:${hash}\n")
        endforeach()
        get_target_property(definitions DKRExperimentalOwnedRegistry COMPILE_DEFINITIONS)
        set(next_definitions "")
        set(contracts "{")
        set(separator "")
        foreach(value IN LISTS definitions)
            if(value MATCHES "^DKR_OWNED_BUILD_ID_V(77|80)=\"([a-f0-9]+)\"$")
                set(revision "${CMAKE_MATCH_1}")
                set(previous "${CMAKE_MATCH_2}")
                string(SHA256 hash "${previous}\n${ledger}")
                set(value "DKR_OWNED_BUILD_ID_V${revision}=\"${hash}\"")
                string(APPEND contracts "${separator}\"${revision}\":\"${hash}\"")
                set(separator ",")
            endif()
            list(APPEND next_definitions "${value}")
        endforeach()
        string(APPEND contracts "}\n")
        if(separator STREQUAL "")
            message(FATAL_ERROR "Repair did not extend the owned build identity")
        endif()
        set_property(TARGET DKRExperimentalOwnedRegistry PROPERTY COMPILE_DEFINITIONS "${next_definitions}")
        file(WRITE "${stage}/repair-contracts.json" "${contracts}")
        message(STATUS "Magic Code work isolation and post-mod viewport heap repair composed; validation retained")
    endfunction()
    cmake_language(DEFER CALL dkr_apply_mod_runtime_repair)
endif()
