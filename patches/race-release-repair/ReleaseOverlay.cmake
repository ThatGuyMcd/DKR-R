include("${CMAKE_CURRENT_LIST_DIR}/../lobby-stability/ReleaseOverlay.cmake")
if(PROJECT_NAME STREQUAL "DKRRuntimePreparation")
 function(dkr_apply_race_release_repair)
  set(auth "${DKRPORT_ROOT}/patches/race-release-repair")
  set(stage "${CMAKE_BINARY_DIR}/generated/race-release-repair")
  file(MAKE_DIRECTORY "${stage}")
  get_target_property(paths DKRPortGame SOURCES)
  list(FILTER paths INCLUDE REGEX "[/\\]party_runtime[.]cpp$")
  list(LENGTH paths count)
  if(NOT count EQUAL 1)
   message(FATAL_ERROR "Race release repair needs one final party runtime")
  endif()
  list(GET paths 0 old)
  file(TO_CMAKE_PATH "${old}" old)
  file(WRITE "${stage}/inputs.json" "[{\"target\":\"DKRPortGame\",\"path\":\"${old}\"}]")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
   "${auth}/pipeline.py" "${auth}/transforms.py" "${auth}/ReleaseOverlay.cmake")
  execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${auth}/pipeline.py"
   --inputs "${stage}/inputs.json" --output "${stage}" RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
   message(FATAL_ERROR "Race release repair could not stage")
  endif()
  set(next "${stage}/party_runtime.cpp")
  get_target_property(directory DKRPortGame SOURCE_DIR)
  foreach(property INCLUDE_DIRECTORIES COMPILE_OPTIONS COMPILE_DEFINITIONS)
   get_property(defined SOURCE "${old}" DIRECTORY "${directory}" PROPERTY ${property} SET)
   if(defined)
    get_property(value SOURCE "${old}" DIRECTORY "${directory}" PROPERTY ${property})
    set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY ${property} "${value}")
   endif()
  endforeach()
  get_filename_component(prior "${old}" DIRECTORY)
  get_property(includes SOURCE "${next}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES)
  set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES "${stage};${prior};${includes}")
  dkr_repair_replace_source(DKRPortGame "${old}" "${next}")
  set(ledger "party-activated-release-v1\n")
  foreach(path "${auth}/pipeline.py" "${auth}/transforms.py" "${auth}/ReleaseOverlay.cmake")
   get_filename_component(name "${path}" NAME)
   file(SHA256 "${path}" hash)
   string(APPEND ledger "${name}:${hash}\n")
  endforeach()
  string(SHA256 contract "${ledger}")
  get_target_property(definitions DKRExperimentalOwnedRegistry COMPILE_DEFINITIONS)
  set(updated "")
  set(contracts "{")
  set(separator "")
  foreach(value IN LISTS definitions)
   if(value MATCHES "^DKR_OWNED_BUILD_ID_V(77|80)=\"([a-f0-9]+)\"$")
    set(revision "${CMAKE_MATCH_1}")
    string(SHA256 hash "${CMAKE_MATCH_2}\n${ledger}")
    set(value "DKR_OWNED_BUILD_ID_V${revision}=\"${hash}\"")
    string(APPEND contracts "${separator}\"${revision}\":\"${hash}\"")
    set(separator ",")
   endif()
   list(APPEND updated "${value}")
  endforeach()
  if(separator STREQUAL "")
   message(FATAL_ERROR "Race release peer contracts missing")
  endif()
  string(APPEND contracts "}")
  file(WRITE "${stage}/contracts.json" "${contracts}")
  file(WRITE "${stage}/contract.txt" "${contract}\n")
  set_property(TARGET DKRExperimentalOwnedRegistry PROPERTY COMPILE_DEFINITIONS "${updated}")
  if(DKR_RELEASE_EVIDENCE)
   file(WRITE "${DKR_RELEASE_EVIDENCE}/DKRExperimentalOwnedRegistry-COMPILE_DEFINITIONS.txt" "${updated}\n")
  endif()
  # The fixture includes the exact compiled handler. It substitutes a tiny
  # synthetic OwnedGame only; no ROM, guest CPU, renderer or RSP is executed.
  foreach(test DKRRaceReleaseChecks DKRRaceReleaseBeforeChecks)
   add_executable(${test} EXCLUDE_FROM_ALL "${auth}/tests/runtime_tests.cpp")
   if(test STREQUAL "DKRRaceReleaseChecks")
    set(test_source "${next}")
   else()
    set(test_source "${old}")
   endif()
   target_compile_definitions(${test} PRIVATE "DKR_RACE_RELEASE_SOURCE=\"${test_source}\"")
   target_compile_features(${test} PRIVATE cxx_std_20)
   get_target_property(test_include_directories DKRPortGame INCLUDE_DIRECTORIES)
   target_include_directories(${test} PRIVATE ${test_include_directories})
   target_include_directories(${test} PRIVATE "${CMAKE_BINARY_DIR}/generated/spectators"
    "${DKRPORT_ROOT}/runtime-recomp/tests/replay_probe" "${DKRPORT_ROOT}/runtime-recomp/src/game")
   target_link_libraries(${test} PRIVATE DKRNetplayCore)
   get_target_property(test_link_directories DKRPortGame LINK_DIRECTORIES)
   if(test_link_directories)
    target_link_directories(${test} PRIVATE ${test_link_directories})
   endif()
  endforeach()
 endfunction()
 cmake_language(DEFER CALL dkr_apply_race_release_repair)
endif()
