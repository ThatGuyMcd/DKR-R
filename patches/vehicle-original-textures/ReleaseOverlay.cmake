include("${CMAKE_CURRENT_LIST_DIR}/../graphics-handoff/ReleaseOverlay.cmake")
if(PROJECT_NAME STREQUAL "DKRRuntimePreparation")
 function(dkr_apply_original_car_textures)
  set(auth "${DKRPORT_ROOT}/patches/vehicle-original-textures")
  set(stage "${CMAKE_BINARY_DIR}/generated/vehicle-original-textures")
  file(MAKE_DIRECTORY "${stage}")
  set(rows "[")
  set(separator "")
  foreach(entry "DKRCustomVehicles|vehicle_package.cpp" "DKRPortGame|vehicle_rt64.cpp")
   string(REPLACE "|" ";" fields "${entry}")
   list(GET fields 0 target)
   list(GET fields 1 name)
   get_target_property(paths ${target} SOURCES)
   list(FILTER paths INCLUDE REGEX "[/\\]${name}$")
   list(LENGTH paths count)
   if(NOT count EQUAL 1)
    message(FATAL_ERROR "Original car textures need one final ${target}/${name}")
   endif()
   list(GET paths 0 path)
   file(TO_CMAKE_PATH "${path}" path)
   if(target STREQUAL "DKRCustomVehicles")
    set(original_package "${path}")
   endif()
   string(APPEND rows "${separator}{\"target\":\"${target}\",\"path\":\"${path}\"}")
   set(separator ",")
  endforeach()
  string(APPEND rows "]")
  file(WRITE "${stage}/inputs.json" "${rows}")
  file(GLOB authored CONFIGURE_DEPENDS "${auth}/native/*" "${auth}/tests/*.cpp")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${authored} "${auth}/pipeline.py" "${auth}/ReleaseOverlay.cmake")
  execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${auth}/pipeline.py" --inputs "${stage}/inputs.json" --output "${stage}" RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
   message(FATAL_ERROR "Original car texture staging failed")
  endif()
  file(READ "${stage}/swaps.json" swaps)
  foreach(index RANGE 1)
   string(JSON target GET "${swaps}" ${index} target)
   string(JSON old GET "${swaps}" ${index} path)
   string(JSON next GET "${swaps}" ${index} new)
   get_target_property(directory ${target} SOURCE_DIR)
   foreach(property INCLUDE_DIRECTORIES COMPILE_OPTIONS COMPILE_DEFINITIONS)
    get_property(defined SOURCE "${old}" DIRECTORY "${directory}" PROPERTY ${property} SET)
    if(defined)
     get_property(value SOURCE "${old}" DIRECTORY "${directory}" PROPERTY ${property})
     set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY ${property} "${value}")
    endif()
   endforeach()
   get_filename_component(prior "${old}" DIRECTORY)
   get_property(includes SOURCE "${next}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES)
   set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES "${stage};${prior};${includes}")
   dkr_repair_replace_source(${target} "${old}" "${next}")
  endforeach()
  get_filename_component(package_directory "${original_package}" DIRECTORY)
  add_executable(DKRVehicleOriginalChecks EXCLUDE_FROM_ALL "${auth}/tests/package_checks.cpp")
  target_compile_features(DKRVehicleOriginalChecks PRIVATE cxx_std_20)
  target_include_directories(DKRVehicleOriginalChecks PRIVATE "${stage}" "${package_directory}")
  target_link_libraries(DKRVehicleOriginalChecks PRIVATE DKRCustomVehicles)
  add_executable(DKRVehicleOriginalBeforeChecks EXCLUDE_FROM_ALL "${auth}/tests/package_checks.cpp" "${original_package}")
  target_compile_features(DKRVehicleOriginalBeforeChecks PRIVATE cxx_std_20)
  target_compile_definitions(DKRVehicleOriginalBeforeChecks PRIVATE DKR_VEHICLE_BEFORE=1 NOMINMAX)
  target_include_directories(DKRVehicleOriginalBeforeChecks PRIVATE "${stage}" "${package_directory}" "${DKR_DEPENDENCIES_DIR}/rt64/src/contrib")
  target_link_libraries(DKRVehicleOriginalBeforeChecks PRIVATE DKRCustomMagicCodes DKRLegacyModCore)
  get_target_property(test_link_directories DKRPortGame LINK_DIRECTORIES)
  if(test_link_directories)
   foreach(target DKRVehicleOriginalChecks DKRVehicleOriginalBeforeChecks)
    target_link_directories(${target} PRIVATE ${test_link_directories})
   endforeach()
  endif()
  if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang" AND NOT WIN32)
   add_executable(DKRVehicleOriginalSanitizerChecks EXCLUDE_FROM_ALL "${auth}/tests/package_checks.cpp" "${stage}/DKRCustomVehicles/vehicle_package.cpp")
   target_compile_features(DKRVehicleOriginalSanitizerChecks PRIVATE cxx_std_20)
   target_compile_definitions(DKRVehicleOriginalSanitizerChecks PRIVATE NOMINMAX)
   target_compile_options(DKRVehicleOriginalSanitizerChecks PRIVATE -g -O1 -fsanitize=address,undefined -fno-omit-frame-pointer)
   target_link_options(DKRVehicleOriginalSanitizerChecks PRIVATE -fsanitize=address,undefined)
   target_include_directories(DKRVehicleOriginalSanitizerChecks PRIVATE "${stage}" "${package_directory}" "${DKR_DEPENDENCIES_DIR}/rt64/src/contrib")
   target_link_libraries(DKRVehicleOriginalSanitizerChecks PRIVATE DKRCustomMagicCodes DKRLegacyModCore)
  endif()
  if(DKR_RELEASE_EVIDENCE)
   foreach(target DKRCustomVehicles DKRPortGame)
    get_target_property(paths ${target} SOURCES)
    file(WRITE "${DKR_RELEASE_EVIDENCE}/${target}-ORIGINAL-CAR-SOURCES.txt" "${paths}\n")
   endforeach()
  endif()
 endfunction()
 cmake_language(DEFER CALL dkr_apply_original_car_textures)
endif()
