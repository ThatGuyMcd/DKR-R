include("${CMAKE_CURRENT_LIST_DIR}/../performance-surgical/NativeOverlay.cmake")
if(PROJECT_NAME STREQUAL "DKRRuntimePreparation")
    function(dkr_apply_liquid_streaming)
        execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${DKRPORT_ROOT}/patches/liquid-streaming/pipeline.py"
            verify --output "${DKR_LIQUID_STREAMING_STAGE}" RESULT_VARIABLE status)
        if(NOT status EQUAL 0)
            message(FATAL_ERROR "Liquid streaming source receipt failed")
        endif()
        set(total 0)
        foreach(target DKRPortGame rt64)
            get_target_property(sources ${target} SOURCES)
            get_target_property(directory ${target} SOURCE_DIR)
            set(replaced)
            foreach(source IN LISTS sources)
                set(next "")
                if(target STREQUAL "DKRPortGame" AND source MATCHES "/f3ddkr_rt64\\.cpp$")
                    set(next "${DKR_LIQUID_STREAMING_STAGE}/native/f3ddkr_rt64.cpp")
                elseif(target STREQUAL "rt64" AND source MATCHES "/(rt64_texture_cache|rt64_framebuffer_renderer)\\.cpp$")
                    get_filename_component(name "${source}" NAME)
                    set(next "${DKR_LIQUID_STREAMING_STAGE}/renderer/${name}")
                endif()
                if(next)
                    math(EXPR total "${total}+1")
                    foreach(property INCLUDE_DIRECTORIES COMPILE_OPTIONS COMPILE_DEFINITIONS)
                        get_property(defined SOURCE "${source}" DIRECTORY "${directory}" PROPERTY ${property} SET)
                        if(defined)
                            get_property(value SOURCE "${source}" DIRECTORY "${directory}" PROPERTY ${property})
                            set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY ${property} "${value}")
                        endif()
                    endforeach()
                    get_filename_component(prior "${source}" DIRECTORY)
                    get_property(includes SOURCE "${next}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES)
                    set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES
                        "${DKR_LIQUID_STREAMING_STAGE}/native;${prior};${includes}")
                    list(APPEND replaced "${next}")
                else()
                    list(APPEND replaced "${source}")
                endif()
            endforeach()
            set_property(TARGET ${target} PROPERTY SOURCES "${replaced}")
        endforeach()
        if(NOT total EQUAL 3)
            message(FATAL_ERROR "Expected three explicit liquid streaming source overrides, found ${total}")
        endif()
    endfunction()
    cmake_language(DEFER CALL dkr_apply_liquid_streaming)
endif()
