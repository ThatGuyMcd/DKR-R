include("${CMAKE_CURRENT_LIST_DIR}/../presentation-polish/NativeOverlay.cmake")
if(PROJECT_NAME STREQUAL "DKRRuntimePreparation")
    function(dkr_apply_surgical_performance)
        execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${DKRPORT_ROOT}/patches/performance-surgical/pipeline.py"
            verify --output "${DKR_SURGICAL_PERFORMANCE_STAGE}" RESULT_VARIABLE status)
        if(NOT status EQUAL 0)
            message(FATAL_ERROR "Surgical performance source receipt failed")
        endif()
        set(total 0)
        foreach(target DKRPortGame DKRCustomMagicCodes rt64)
            get_target_property(sources ${target} SOURCES)
            get_target_property(directory ${target} SOURCE_DIR)
            set(replaced)
            foreach(source IN LISTS sources)
                set(next "")
                if(target STREQUAL "DKRPortGame" AND source MATCHES "/(f3ddkr_rt64|rt64_renderer)\\.cpp$")
                    get_filename_component(name "${source}" NAME)
                    set(next "${DKR_SURGICAL_PERFORMANCE_STAGE}/native/${name}")
                elseif(target STREQUAL "DKRCustomMagicCodes" AND source MATCHES "/magic_code_world\\.cpp$")
                    set(next "${DKR_SURGICAL_PERFORMANCE_STAGE}/native/mods/magic_code_world.cpp")
                elseif(target STREQUAL "rt64" AND source MATCHES "/(rt64_texture_cache|rt64_present_queue)\\.cpp$")
                    get_filename_component(name "${source}" NAME)
                    set(next "${DKR_SURGICAL_PERFORMANCE_STAGE}/renderer/${name}")
                endif()
                if(next)
                    math(EXPR total "${total}+1")
                    foreach(property INCLUDE_DIRECTORIES COMPILE_OPTIONS COMPILE_DEFINITIONS)
                        get_property(defined SOURCE "${source}" DIRECTORY "${directory}" PROPERTY ${property} SET)
                        if(defined)
                            get_property(value SOURCE "${source}" DIRECTORY "${directory}" PROPERTY ${property})
                            set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY ${property} "${value}")
                        endif()
                    endforeach()
                    get_filename_component(prior "${source}" DIRECTORY)
                    get_property(includes SOURCE "${next}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES)
                    set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES
                        "${DKR_SURGICAL_PERFORMANCE_STAGE}/native;${prior};${includes}")
                    list(APPEND replaced "${next}")
                else()
                    list(APPEND replaced "${source}")
                endif()
            endforeach()
            set_property(TARGET ${target} PROPERTY SOURCES "${replaced}")
        endforeach()
        if(NOT total EQUAL 5)
            message(FATAL_ERROR "Expected five explicit performance source overrides, found ${total}")
        endif()
        message(STATUS "Surgical performance: reusable CPU storage, exact lookup/serialization, monotonic presentation; fences unchanged")
    endfunction()
    cmake_language(DEFER CALL dkr_apply_surgical_performance)
endif()
