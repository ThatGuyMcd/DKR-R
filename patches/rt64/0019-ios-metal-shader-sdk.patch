diff --git a/src/tools/file_to_c/CMakeLists.txt b/src/tools/file_to_c/CMakeLists.txt
--- a/src/tools/file_to_c/CMakeLists.txt	2026-10-10 20:40:20
+++ b/src/tools/file_to_c/CMakeLists.txt	2026-10-10 20:40:20
@@ -1,3 +1,14 @@
+if (IOS)
+    if (NOT DKR_HOST_FILE_TO_C OR NOT EXISTS "${DKR_HOST_FILE_TO_C}")
+        message(FATAL_ERROR "iOS builds require DKR_HOST_FILE_TO_C, an existing host file_to_c executable.")
+    endif()
+    add_executable(file_to_c IMPORTED GLOBAL)
+    set_target_properties(file_to_c PROPERTIES
+        IMPORTED_LOCATION "${DKR_HOST_FILE_TO_C}"
+    )
+    return()
+endif()
+
 cmake_minimum_required(VERSION 3.20)
 project(file_to_c)
 set(CMAKE_CXX_STANDARD 17)
