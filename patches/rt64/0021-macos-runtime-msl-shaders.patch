diff --git a/CMakeLists.txt b/CMakeLists.txt
index 17563c1..f4ecee6 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -163,17 +163,39 @@ function(build_shader_msl_impl TARGETOBJ FILENAME TARGET_NAME OUTNAME)
         add_custom_command(OUTPUT ${OUTNAME}.metallib
                 COMMAND xcrun -sdk ${_dkr_ios_metal_sdk} metallib ${OUTNAME}.ir -o ${OUTNAME}.metallib
                 DEPENDS ${OUTNAME}.ir)
+        set(_dkr_msl_blob ${OUTNAME}.metallib)
     else()
-        add_custom_command(OUTPUT ${OUTNAME}.ir
-                COMMAND xcrun -sdk macosx metal -o ${OUTNAME}.ir -c ${OUTNAME}.metal $<$<CONFIG:Debug>:-frecord-sources>
-                DEPENDS ${OUTNAME}.metal)
-        add_custom_command(OUTPUT ${OUTNAME}.metallib
-                COMMAND xcrun -sdk macosx metallib ${OUTNAME}.ir -o ${OUTNAME}.metallib
-                DEPENDS ${OUTNAME}.ir)
+        # Precompile when the Metal toolchain runs (full Xcode). With only the
+        # Command Line Tools, embed the MSL source and let plume compile it at
+        # runtime instead. That costs a source compile per RasterShader, since each
+        # one creates its library from these blobs.
+        if (NOT DEFINED DKR_RT64_PRECOMPILE_MSL)
+            execute_process(COMMAND xcrun -sdk macosx metal -v
+                    RESULT_VARIABLE _dkr_metal_probe OUTPUT_QUIET ERROR_QUIET)
+            if (_dkr_metal_probe EQUAL 0)
+                set(_dkr_metal_found ON)
+            else()
+                set(_dkr_metal_found OFF)
+            endif()
+            set(DKR_RT64_PRECOMPILE_MSL ${_dkr_metal_found} CACHE BOOL
+                    "Precompile RT64 Metal shaders into metallibs (needs the Xcode Metal toolchain)")
+            message(STATUS "RT64 Metal shaders: precompiled metallibs = ${DKR_RT64_PRECOMPILE_MSL}")
+        endif()
+        if (DKR_RT64_PRECOMPILE_MSL)
+            add_custom_command(OUTPUT ${OUTNAME}.ir
+                    COMMAND xcrun -sdk macosx metal -o ${OUTNAME}.ir -c ${OUTNAME}.metal $<$<CONFIG:Debug>:-frecord-sources>
+                    DEPENDS ${OUTNAME}.metal)
+            add_custom_command(OUTPUT ${OUTNAME}.metallib
+                    COMMAND xcrun -sdk macosx metallib ${OUTNAME}.ir -o ${OUTNAME}.metallib
+                    DEPENDS ${OUTNAME}.ir)
+            set(_dkr_msl_blob ${OUTNAME}.metallib)
+        else()
+            set(_dkr_msl_blob ${OUTNAME}.metal)
+        endif()
     endif()
     add_custom_command(OUTPUT ${OUTNAME}.metal.c
-            COMMAND file_to_c ${OUTNAME}.metallib ${TARGET_NAME}BlobMSL ${OUTNAME}.metal.c ${OUTNAME}.metal.h
-            DEPENDS ${OUTNAME}.metallib file_to_c
+            COMMAND file_to_c ${_dkr_msl_blob} ${TARGET_NAME}BlobMSL ${OUTNAME}.metal.c ${OUTNAME}.metal.h
+            DEPENDS ${_dkr_msl_blob} file_to_c
             BYPRODUCTS ${OUTNAME}.metal.h)
     target_sources(${TARGETOBJ} PRIVATE ${OUTNAME}.metal.c)
 endfunction()
