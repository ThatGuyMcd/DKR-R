include("${CMAKE_CURRENT_LIST_DIR}/../online-performance/ReleaseOverlay.cmake")
if(PROJECT_NAME STREQUAL "DKRRuntimePreparation")
 function(dkr_apply_character_portraits)
  set(auth "${DKRPORT_ROOT}/patches/character-library-portraits")
  set(stage "${CMAKE_BINARY_DIR}/generated/character-library-portraits")
  file(MAKE_DIRECTORY "${stage}")
  get_target_property(sources DKRPortGame SOURCES)
  list(FILTER sources INCLUDE REGEX "[/\\]runtime_ui.cpp$")
  list(LENGTH sources count)
  if(NOT count EQUAL 1)
   message(FATAL_ERROR "Character portraits need one final launcher source")
  endif()
  list(GET sources 0 old)
  file(TO_CMAKE_PATH "${old}" old)
  get_target_property(account_sources DKRPortGame SOURCES)
  list(FILTER account_sources INCLUDE REGEX "[/\\]mod_store.cpp$")
  list(LENGTH account_sources account_count)
  if(NOT account_count EQUAL 1)
   message(FATAL_ERROR "Online profile needs one account service source")
  endif()
  list(GET account_sources 0 account_old)
  file(TO_CMAKE_PATH "${account_old}" account_old)
  get_target_property(game_source_dir DKRPortGame SOURCE_DIR)
  get_property(ui_include_dirs SOURCE "${old}" DIRECTORY "${game_source_dir}" PROPERTY INCLUDE_DIRECTORIES)
  get_target_property(game_include_dirs DKRPortGame INCLUDE_DIRECTORIES)
  get_filename_component(ui_parent "${old}" DIRECTORY)
  set(code_ui "")
  set(code_include_dirs "${ui_parent}" ${ui_include_dirs} ${game_include_dirs})
  foreach(folder IN LISTS code_include_dirs)
   if(EXISTS "${folder}/runtime_code_mods_ui.inl")
    file(TO_CMAKE_PATH "${folder}/runtime_code_mods_ui.inl" code_ui)
    break()
   endif()
  endforeach()
  if(NOT code_ui)
   message(FATAL_ERROR "The selected launcher must provide its code details include")
  endif()
  set(saves_ui "")
  foreach(folder IN LISTS code_include_dirs)
   if(EXISTS "${folder}/runtime_saves_ui.inl")
    file(TO_CMAKE_PATH "${folder}/runtime_saves_ui.inl" saves_ui)
    break()
   endif()
  endforeach()
  if(NOT saves_ui)
   message(FATAL_ERROR "The selected launcher must provide its save page include")
  endif()
  file(WRITE "${stage}/inputs.json" "[{\"target\":\"DKRPortGame\",\"path\":\"${old}\",\"codeUi\":\"${code_ui}\",\"savesUi\":\"${saves_ui}\"},{\"target\":\"DKRPortGame\",\"path\":\"${CMAKE_BINARY_DIR}/generated/custom-vehicles/native/runtime_mod_library_ui.inl\"},{\"target\":\"DKRPortGame\",\"path\":\"${account_old}\"}]")
  file(READ "${stage}/inputs.json" feedback_inputs)
  string(REGEX REPLACE "\\]$" "" feedback_inputs "${feedback_inputs}")
  foreach(pair IN ITEMS "DKRPortGame|runtime_platform.cpp" "DKRCameraPresentation|camera_rt64.cpp")
   string(REPLACE "|" ";" parts "${pair}")
   list(GET parts 0 owner)
   list(GET parts 1 filename)
   get_target_property(selected ${owner} SOURCES)
   list(FILTER selected INCLUDE REGEX "[/\\]${filename}$")
   list(LENGTH selected selected_count)
   if(NOT selected_count EQUAL 1)
    message(FATAL_ERROR "Controller feedback needs one ${owner}/${filename}")
   endif()
   list(GET selected 0 selected_path)
   file(TO_CMAKE_PATH "${selected_path}" selected_path)
   string(APPEND feedback_inputs ",{\"target\":\"${owner}\",\"path\":\"${selected_path}\"}")
  endforeach()
  file(WRITE "${stage}/inputs.json" "${feedback_inputs}]")
  file(GLOB authored CONFIGURE_DEPENDS "${auth}/native/*" "${auth}/tests/*")
  file(GLOB profile_authored CONFIGURE_DEPENDS "${DKRPORT_ROOT}/runtime-recomp/src/game/online_profile/*")
  list(APPEND authored ${profile_authored})
  list(APPEND authored "${DKRPORT_ROOT}/runtime-recomp/src/game/mod_store/download_history.hpp")
  file(GLOB store_authored CONFIGURE_DEPENDS "${DKRPORT_ROOT}/runtime-recomp/src/game/mod_store/*")
  list(APPEND authored ${store_authored})
  file(GLOB theme_authored CONFIGURE_DEPENDS "${DKRPORT_ROOT}/runtime-recomp/src/game/launcher_themes/*")
  list(APPEND authored ${theme_authored} "${DKRPORT_ROOT}/runtime-recomp/cmake/LauncherThemes.cmake")
  file(GLOB library_ui_authored CONFIGURE_DEPENDS "${DKRPORT_ROOT}/runtime-recomp/src/game/library_ui/*")
  list(APPEND library_ui_authored "${DKRPORT_ROOT}/runtime-recomp/src/game/launcher_gpu.hpp")
  list(APPEND authored ${library_ui_authored} "${DKRPORT_ROOT}/runtime-recomp/cmake/LibraryUi.cmake")
  # Localisation is a normal first-party target; its sources/resources use
  # compiler and custom-command dependencies rather than capsule restaging.
  file(GLOB feedback_authored CONFIGURE_DEPENDS "${DKRPORT_ROOT}/runtime-recomp/src/game/controller_feedback/*")
  list(APPEND authored ${feedback_authored} "${DKRPORT_ROOT}/runtime-recomp/cmake/ControllerFeedback.cmake")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${authored} "${auth}/pipeline.py" "${auth}/ReleaseOverlay.cmake")
  execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${auth}/pipeline.py" --inputs "${stage}/inputs.json" --output "${stage}" RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
   message(FATAL_ERROR "Character portraits staging failed")
  endif()
  set(next "${stage}/runtime_ui.cpp")
  get_target_property(directory DKRPortGame SOURCE_DIR)
  foreach(property INCLUDE_DIRECTORIES COMPILE_OPTIONS COMPILE_DEFINITIONS)
   get_property(defined SOURCE "${old}" DIRECTORY "${directory}" PROPERTY ${property} SET)
   if(defined)
    get_property(value SOURCE "${old}" DIRECTORY "${directory}" PROPERTY ${property})
    set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY ${property} "${value}")
   endif()
  endforeach()
  get_filename_component(prior "${old}" DIRECTORY)
  get_property(includes SOURCE "${next}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES)
  set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES "${stage};${prior};${includes}")
  dkr_repair_replace_source(DKRPortGame "${old}" "${next}")
  set(next "${stage}/mod_store.cpp")
  foreach(property INCLUDE_DIRECTORIES COMPILE_OPTIONS COMPILE_DEFINITIONS)
   get_property(defined SOURCE "${account_old}" DIRECTORY "${directory}" PROPERTY ${property} SET)
   if(defined)
    get_property(value SOURCE "${account_old}" DIRECTORY "${directory}" PROPERTY ${property})
    set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY ${property} "${value}")
   endif()
  endforeach()
  get_filename_component(prior "${account_old}" DIRECTORY)
  get_property(includes SOURCE "${next}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES)
  set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES "${stage};${prior};${includes}")
  dkr_repair_replace_source(DKRPortGame "${account_old}" "${next}")
  foreach(pair IN ITEMS "DKRPortGame|runtime_platform.cpp" "DKRCameraPresentation|camera_rt64.cpp")
   string(REPLACE "|" ";" parts "${pair}")
   list(GET parts 0 owner)
   list(GET parts 1 filename)
   get_target_property(selected ${owner} SOURCES)
   list(FILTER selected INCLUDE REGEX "[/\\]${filename}$")
   list(GET selected 0 selected_path)
   get_target_property(owner_directory ${owner} SOURCE_DIR)
   foreach(property INCLUDE_DIRECTORIES COMPILE_OPTIONS COMPILE_DEFINITIONS)
    get_property(value SOURCE "${selected_path}" DIRECTORY "${owner_directory}" PROPERTY ${property})
    if(value)
     set_property(SOURCE "${stage}/${filename}" DIRECTORY "${owner_directory}" PROPERTY ${property} "${value}")
    endif()
   endforeach()
   dkr_repair_replace_source(${owner} "${selected_path}" "${stage}/${filename}")
  endforeach()
  foreach(pair IN ITEMS "DKRPortGame|sdl3_input_client.cpp|input_client.cpp" "DKRSdl3InputHost|sdl3_input_host.cpp|input_host.cpp" "DKRSdl3InputClientTests|sdl3_input_client.cpp|input_client.cpp")
   string(REPLACE "|" ";" parts "${pair}")
   list(GET parts 0 owner)
   list(GET parts 1 filename)
   list(GET parts 2 replacement)
   if(TARGET ${owner})
    get_target_property(selected ${owner} SOURCES)
    list(FILTER selected INCLUDE REGEX "[/\\]${filename}$")
    list(LENGTH selected n)
    if(NOT n EQUAL 1)
     message(FATAL_ERROR "Controller feedback input owner differs")
    endif()
    list(GET selected 0 selected_path)
    if(NOT selected_path STREQUAL "${DKRPORT_ROOT}/runtime-recomp/src/game/controller_feedback/${replacement}")
     dkr_repair_replace_source(${owner} "${selected_path}" "${DKRPORT_ROOT}/runtime-recomp/src/game/controller_feedback/${replacement}")
    endif()
    if(owner STREQUAL "DKRSdl3InputHost")
     target_include_directories(${owner} BEFORE PRIVATE "${DKRPORT_ROOT}/runtime-recomp/src/game")
    endif()
   endif()
  endforeach()
  include("${DKRPORT_ROOT}/runtime-recomp/cmake/ControllerFeedback.cmake")
  dkr_add_controller_feedback_checks()
  target_sources(DKRPortGame PRIVATE "${DKRPORT_ROOT}/runtime-recomp/src/game/mod_store/overlay_images.cpp")
  include("${DKRPORT_ROOT}/runtime-recomp/cmake/ModStoreCommunity.cmake")
  dkr_add_mod_store_community_tests()
  include("${DKRPORT_ROOT}/runtime-recomp/cmake/LauncherThemes.cmake")
  dkr_add_launcher_theme_checks()
  dkr_add_launcher_theme_render_check()
  include("${DKRPORT_ROOT}/runtime-recomp/cmake/LibraryUi.cmake")
  dkr_add_library_ui_checks()
  target_link_libraries(DKRPortGame PRIVATE DKRCrashReports)
  include("${DKRPORT_ROOT}/runtime-recomp/cmake/VehicleLighting.cmake")
  dkr_add_vehicle_lighting_checks()
  get_target_property(friend_sources DKRNetplayCore SOURCES)
  list(FILTER friend_sources INCLUDE REGEX "[/\\]friend_service.cpp$")
  list(LENGTH friend_sources friend_count)
  if(NOT friend_count EQUAL 1)
   message(FATAL_ERROR "Social profiles need one retained friend service")
  endif()
  list(GET friend_sources 0 friend_old)
  file(TO_CMAKE_PATH "${friend_old}" friend_old)
  if(NOT friend_old STREQUAL "${CMAKE_BINARY_DIR}/generated/online-performance/DKRNetplayCore/friend_service.cpp")
   dkr_repair_replace_source(DKRNetplayCore "${friend_old}" "${DKRPORT_ROOT}/runtime-recomp/src/game/online_profile/friend_service.cpp")
  endif()
  add_library(DKRCharacterPortraits STATIC "${stage}/character_portraits.cpp")
  target_compile_features(DKRCharacterPortraits PRIVATE cxx_std_20)
  target_compile_definitions(DKRCharacterPortraits PRIVATE NOMINMAX)
  target_include_directories(DKRCharacterPortraits PUBLIC "${stage}" PRIVATE "${DKRPORT_ROOT}/patches/texture-dumping/native")
  target_link_libraries(DKRCharacterPortraits PUBLIC DKRLegacyModCore)
  target_link_libraries(DKRPortGame PRIVATE DKRCharacterPortraits)
  include("${DKRPORT_ROOT}/runtime-recomp/cmake/Localisation.cmake")
  dkr_add_localisation()
  target_link_libraries(DKRPortGame PRIVATE DKRLocalisation)
  add_executable(DKRCharacterPortraitChecks EXCLUDE_FROM_ALL "${auth}/tests/portrait_checks.cpp")
  target_compile_features(DKRCharacterPortraitChecks PRIVATE cxx_std_20)
  target_compile_definitions(DKRCharacterPortraitChecks PRIVATE NOMINMAX)
  target_link_libraries(DKRCharacterPortraitChecks PRIVATE DKRCharacterPortraits)
  add_executable(DKRProfileChecks EXCLUDE_FROM_ALL "${DKRPORT_ROOT}/runtime-recomp/tests/online_profile_tests.cpp")
  target_compile_features(DKRProfileChecks PRIVATE cxx_std_20)
  target_include_directories(DKRProfileChecks PRIVATE "${DKRPORT_ROOT}/runtime-recomp/src/game")
  add_executable(DKRModStoreHistoryChecks EXCLUDE_FROM_ALL "${DKRPORT_ROOT}/runtime-recomp/tests/mod_store_history_tests.cpp")
  target_compile_features(DKRModStoreHistoryChecks PRIVATE cxx_std_20)
  target_include_directories(DKRModStoreHistoryChecks PRIVATE "${DKRPORT_ROOT}/runtime-recomp/src/game"
      "${DKRPORT_ROOT}/extern/rt64/src/contrib")
  get_target_property(links DKRPortGame LINK_DIRECTORIES)
  if(links)
   target_link_directories(DKRCharacterPortraitChecks PRIVATE ${links})
  endif()
 endfunction()
 cmake_language(DEFER CALL dkr_apply_character_portraits)
endif()
