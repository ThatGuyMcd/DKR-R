include("${CMAKE_CURRENT_LIST_DIR}/../spectator-admission-repair/ReleaseOverlay.cmake")
if(PROJECT_NAME STREQUAL "DKRRuntimePreparation")
 function(dkr_apply_memory_stability)
  set(auth "${DKRPORT_ROOT}/patches/memory-stability")
  set(stage "${CMAKE_BINARY_DIR}/generated/memory-stability")
  file(MAKE_DIRECTORY "${stage}")
  set(rows "[")
  set(separator "")
  foreach(key legacy hud owned77 owned80)
   if(key STREQUAL "legacy")
    set(target DKRPortGame)
    set(name runtime_legacy_mods.cpp)
   elseif(key STREQUAL "hud")
    set(target DKRPortGame)
    set(name runtime_hud_layout.cpp)
   else()
    string(REGEX REPLACE "owned" "" revision "${key}")
    set(target DKRExperimentalOwnedGameV${revision})
    set(name probe_native.c)
   endif()
   get_target_property(paths ${target} SOURCES)
   list(FILTER paths INCLUDE REGEX "[/\\]${name}$")
   list(LENGTH paths count)
   if(NOT count EQUAL 1)
    message(FATAL_ERROR "Memory repair needs one final ${name}")
   endif()
   list(GET paths 0 old)
   file(TO_CMAKE_PATH "${old}" old)
   set(old_${key} "${old}")
   set(target_${key} "${target}")
   set(name_${key} "${name}")
   string(APPEND rows "${separator}{\"target\":\"${target}\",\"path\":\"${old}\"}")
   set(separator ",")
  endforeach()
  string(APPEND rows "]")
  file(WRITE "${stage}/inputs.json" "${rows}")
  set(allocator_rows "[")
  set(separator "")
  foreach(revision 77 80)
   get_target_property(paths DKRRecompiledFuncsV${revision} SOURCES)
   list(FILTER paths INCLUDE REGEX "[.]c$")
   foreach(path IN LISTS paths)
    file(TO_CMAKE_PATH "${path}" path)
    string(APPEND allocator_rows "${separator}{\"revision\":${revision},\"path\":\"${path}\"}")
    set(separator ",")
   endforeach()
  endforeach()
  string(APPEND allocator_rows "]")
  file(WRITE "${stage}/allocator-sources.json" "${allocator_rows}")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
   "${auth}/ReleaseOverlay.cmake" "${auth}/pipeline.py" "${auth}/native/primary_heap.h")
  execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${auth}/pipeline.py" --inputs "${stage}/inputs.json"
   --output "${stage}" --allocators "${stage}/allocator-sources.json" RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
   message(FATAL_ERROR "Memory repair could not stage")
  endif()
  foreach(key legacy hud owned77 owned80)
   set(target "${target_${key}}")
   get_target_property(directory ${target} SOURCE_DIR)
   set(old "${old_${key}}")
   set(next "${stage}/${target}/${name_${key}}")
   foreach(property INCLUDE_DIRECTORIES COMPILE_OPTIONS COMPILE_DEFINITIONS)
    get_property(defined SOURCE "${old}" DIRECTORY "${directory}" PROPERTY ${property} SET)
    if(defined)
     get_property(value SOURCE "${old}" DIRECTORY "${directory}" PROPERTY ${property})
     set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY ${property} "${value}")
    endif()
   endforeach()
   get_filename_component(prior "${old}" DIRECTORY)
   get_property(includes SOURCE "${next}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES)
   set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES "${stage};${prior};${includes}")
   dkr_repair_replace_source(${target} "${old}" "${next}")
  endforeach()
  # Heap addresses are canonical state. Require matching builds on every peer.
  set(ledger "guarded-primary-heap-v1\n")
  foreach(name ReleaseOverlay.cmake pipeline.py native/primary_heap.h)
   file(SHA256 "${auth}/${name}" hash)
   string(APPEND ledger "${name}:${hash}\n")
  endforeach()
  get_target_property(definitions DKRExperimentalOwnedRegistry COMPILE_DEFINITIONS)
  set(updated "")
  set(contracts "{")
  set(separator "")
  foreach(value IN LISTS definitions)
   if(value MATCHES "^DKR_OWNED_BUILD_ID_V(77|80)=\"([a-f0-9]+)\"$")
    set(revision "${CMAKE_MATCH_1}")
    string(SHA256 hash "${CMAKE_MATCH_2}\n${ledger}")
    set(value "DKR_OWNED_BUILD_ID_V${revision}=\"${hash}\"")
    string(APPEND contracts "${separator}\"${revision}\":\"${hash}\"")
    set(separator ",")
   endif()
   list(APPEND updated "${value}")
  endforeach()
  if(separator STREQUAL "")
   message(FATAL_ERROR "Memory repair peer contracts missing")
  endif()
  string(APPEND contracts "}")
  file(WRITE "${stage}/contracts.json" "${contracts}")
  file(WRITE "${stage}/ledger.txt" "${ledger}")
  set_property(TARGET DKRExperimentalOwnedRegistry PROPERTY COMPILE_DEFINITIONS "${updated}")
  if(DKR_RELEASE_EVIDENCE)
   file(WRITE "${DKR_RELEASE_EVIDENCE}/DKRExperimentalOwnedRegistry-COMPILE_DEFINITIONS.txt" "${updated}\n")
  endif()
  foreach(revision 77 80)
   set(test DKRMemoryStability${revision}Checks)
   add_executable(${test} EXCLUDE_FROM_ALL "${auth}/tests/allocator_tests.cpp" "${stage}/allocator${revision}.c"
    "${DKRPORT_ROOT}/runtime-recomp/src/game/netplay/runtime_state.cpp")
   target_compile_features(${test} PRIVATE cxx_std_20)
   get_target_property(allocator_includes DKRRecompiledFuncsV${revision} INCLUDE_DIRECTORIES)
   target_include_directories(${test} PRIVATE "${stage}" "${DKRPORT_ROOT}/runtime-recomp/src/game" ${allocator_includes})
   target_compile_definitions(${test} PRIVATE DKR_MEMORY_TEST_REVISION=${revision})
   if(MSVC)
    # Negative controls deliberately throw through the original C allocator.
    target_compile_options(${test} PRIVATE "$<$<COMPILE_LANGUAGE:CXX>:/EHsc>" "$<$<COMPILE_LANGUAGE:CXX>:/EHc->")
   endif()
   if(NOT WIN32)
    target_link_libraries(${test} PRIVATE m)
   endif()
   set(entry_test DKRMemoryOwned${revision}Checks)
   add_executable(${entry_test} EXCLUDE_FROM_ALL "${auth}/tests/owned_entry_tests.cpp" "${stage}/owned-entry${revision}.c")
   target_compile_features(${entry_test} PRIVATE cxx_std_20)
   target_include_directories(${entry_test} PRIVATE "${stage}" ${allocator_includes})
  endforeach()
 endfunction()
 cmake_language(DEFER CALL dkr_apply_memory_stability)
endif()
