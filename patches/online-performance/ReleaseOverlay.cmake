include("${CMAKE_CURRENT_LIST_DIR}/../vehicle-original-textures/ReleaseOverlay.cmake")
if(PROJECT_NAME STREQUAL "DKRRuntimePreparation")
 function(dkr_apply_online_performance)
  include("${DKRPORT_ROOT}/runtime-recomp/cmake/OnlineStability.cmake")
  dkr_add_online_stability()
  include("${DKRPORT_ROOT}/runtime-recomp/cmake/AnalogueDriving.cmake")
  dkr_add_analogue_driving_checks()
  # Keep the current social/profile implementation before extending the
  # common input-header closure. The later portrait step keeps this binding.
  get_target_property(social_sources DKRNetplayCore SOURCES)
  list(FILTER social_sources INCLUDE REGEX "friend_service[.]cpp$")
  list(LENGTH social_sources social_count)
  if(NOT social_count EQUAL 1)
   message(FATAL_ERROR "Online input needs one current social service")
  endif()
  list(GET social_sources 0 social_old)
  dkr_repair_replace_source(DKRNetplayCore "${social_old}" "${DKRPORT_ROOT}/runtime-recomp/src/game/online_profile/friend_service.cpp")
  target_link_libraries(DKRNetplayCore PUBLIC DKROnlineStabilityCore)
  target_link_libraries(DKRLegacyImportLibrary PUBLIC DKROnlineStabilityCore)
  # Register this linked consumer before collecting the shared input-header
  # closure. Creating it afterwards gives its test TU the old input ABI.
  add_executable(DKRDirectoryLifecycleChecks EXCLUDE_FROM_ALL "${DKRPORT_ROOT}/runtime-recomp/tests/direct_session_tests.cpp")
  target_compile_features(DKRDirectoryLifecycleChecks PRIVATE cxx_std_20)
  target_compile_definitions(DKRDirectoryLifecycleChecks PRIVATE DKR_DIRECTORY_LIFECYCLE_ONLY=1)
  get_target_property(directory_includes DKRNetplayCore INCLUDE_DIRECTORIES)
  target_include_directories(DKRDirectoryLifecycleChecks PRIVATE "${CMAKE_BINARY_DIR}/generated/online-directory" ${directory_includes})
  target_link_libraries(DKRDirectoryLifecycleChecks PRIVATE DKRNetplayCore)
  add_executable(DKRLiveTimelineTests EXCLUDE_FROM_ALL "${DKRPORT_ROOT}/runtime-recomp/tests/online_stability_timeline_tests.cpp")
  target_compile_features(DKRLiveTimelineTests PRIVATE cxx_std_20)
  get_target_property(timeline_includes DKRNetplayCore INCLUDE_DIRECTORIES)
  target_include_directories(DKRLiveTimelineTests PRIVATE ${timeline_includes})
  target_link_libraries(DKRLiveTimelineTests PRIVATE DKRNetplayCore)
  if(MSVC)
   target_compile_options(DKRLiveTimelineTests PRIVATE /UNDEBUG)
  else()
   target_compile_options(DKRLiveTimelineTests PRIVATE -UNDEBUG)
  endif()
  set(auth "${DKRPORT_ROOT}/patches/online-performance")
  set(stage "${CMAKE_BINARY_DIR}/generated/online-performance")
  file(MAKE_DIRECTORY "${stage}")
  set(rows "[")
  set(separator "")
  set(input_keys)
  foreach(entry "DKRExperimentalOwnedGameV77|probe_native.c" "DKRExperimentalOwnedGameV80|probe_native.c"
   "DKRUpdateInstall|update_process.cpp" "DKRUpdateClient|update_service.cpp" "DKRPortGame|game_main.cpp" "DKRPortGame|party_runtime.cpp"
   "DKRNetplayCore|direct_session.cpp" "DKRNetplayCore|quick_join_transport.cpp"
   "DKRNetplayCore|experimental_lobby_admission.cpp" "DKRNetplayCore|experimental_network.cpp" "DKRNetplayCore|online_mod_admission.cpp" "DKRPortGame|experimental_runtime.cpp"
   "DKRLegacyModCore|online_mod_cache.cpp" "DKRLegacyModCore|online_mod_transfer.cpp" "DKRLegacyImportLibrary|online_mod_profile.cpp" "DKRLegacyImportLibrary|online_mod_sync.cpp"
   "DKRLegacyModLaunch|online_mod_runtime.cpp" "DKRLegacyModWorker|legacy_mod_worker.cpp")
   string(REPLACE "|" ";" fields "${entry}")
   list(GET fields 0 target)
   list(GET fields 1 name)
   get_target_property(paths ${target} SOURCES)
   list(FILTER paths INCLUDE REGEX "[/\\]${name}$")
   list(LENGTH paths count)
   if(NOT count EQUAL 1)
    message(FATAL_ERROR "Online performance needs one final ${target}/${name}")
   endif()
   list(GET paths 0 path)
   file(TO_CMAKE_PATH "${path}" path)
   if(name STREQUAL "online_mod_cache.cpp")
    get_filename_component(cache_headers "${path}" DIRECTORY)
   endif()
   get_target_property(directory ${target} SOURCE_DIR)
   get_target_property(target_includes ${target} INCLUDE_DIRECTORIES)
   get_property(source_includes SOURCE "${path}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES)
   set(include_rows "[")
   set(include_separator "")
   foreach(include IN LISTS source_includes target_includes)
    if(IS_DIRECTORY "${include}")
     file(TO_CMAKE_PATH "${include}" include)
     string(APPEND include_rows "${include_separator}\"${include}\"")
     set(include_separator ",")
    endif()
   endforeach()
   string(APPEND include_rows "]")
   string(APPEND rows "${separator}{\"target\":\"${target}\",\"path\":\"${path}\",\"includes\":${include_rows}}")
   list(APPEND input_keys "${target}|${path}")
   set(separator ",")
  endforeach()
  # The analogue logical input is shared by gameplay, the SDK and owned
  # replay. Include every first-party C++ consumer in this existing checked
  # composition; only affected include closures produce a replacement.
  get_property(beta3_targets DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
  foreach(target IN LISTS beta3_targets)
   get_target_property(directory ${target} SOURCE_DIR)
   get_target_property(paths ${target} SOURCES)
   get_target_property(target_includes ${target} INCLUDE_DIRECTORIES)
   foreach(path IN LISTS paths)
    if(NOT path MATCHES "[.]cpp$" OR path MATCHES "[/\\](extern|thirdparty|contrib|RecompiledFuncs|RecompiledPatches|RecompiledRSP)[/\\]")
     continue()
    endif()
    if(NOT IS_ABSOLUTE "${path}")
     get_filename_component(path "${path}" ABSOLUTE BASE_DIR "${directory}")
    endif()
    if(NOT EXISTS "${path}")
     continue()
    endif()
    file(TO_CMAKE_PATH "${path}" path)
    if("${target}|${path}" IN_LIST input_keys)
     continue()
    endif()
    get_property(source_includes SOURCE "${path}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES)
    set(include_rows "[")
    set(include_separator "")
    foreach(include IN LISTS source_includes target_includes)
     if(IS_DIRECTORY "${include}")
      file(TO_CMAKE_PATH "${include}" include)
      string(APPEND include_rows "${include_separator}\"${include}\"")
      set(include_separator ",")
     endif()
    endforeach()
    string(APPEND include_rows "]")
    set(test_body "")
    if(target STREQUAL "DKRRaceReleaseBeforeChecks")
     get_target_property(test_definitions ${target} COMPILE_DEFINITIONS)
     foreach(definition IN LISTS test_definitions)
      if(definition MATCHES "^DKR_RACE_RELEASE_SOURCE=\"([^\"]+)\"$")
       file(TO_CMAKE_PATH "${CMAKE_MATCH_1}" before_source)
       string(APPEND test_body ",\"test_source\":\"${before_source}\"")
      endif()
     endforeach()
     if(test_body STREQUAL "")
      message(FATAL_ERROR "Race release negative control source missing")
     endif()
    endif()
    string(APPEND rows "${separator}{\"target\":\"${target}\",\"path\":\"${path}\",\"includes\":${include_rows}${test_body}}")
    set(separator ",")
    list(APPEND input_keys "${target}|${path}")
   endforeach()
  endforeach()
  string(APPEND rows "]")
  file(WRITE "${stage}/inputs.json" "${rows}")
  file(GLOB authored CONFIGURE_DEPENDS "${auth}/native/*" "${auth}/tests/*")
  file(GLOB stability_authored CONFIGURE_DEPENDS "${DKRPORT_ROOT}/runtime-recomp/src/game/online_stability/*")
  file(GLOB relay_authored CONFIGURE_DEPENDS "${DKRPORT_ROOT}/runtime-recomp/src/game/netplay/peer_relay/*")
  file(GLOB chat_authored CONFIGURE_DEPENDS "${DKRPORT_ROOT}/runtime-recomp/src/game/netplay/session_chat/*")
  file(GLOB driving_authored CONFIGURE_DEPENDS "${DKRPORT_ROOT}/runtime-recomp/src/game/analog_driving/*" "${DKRPORT_ROOT}/runtime-recomp/src/game/look_behind/*")
  file(GLOB display_authored CONFIGURE_DEPENDS "${DKRPORT_ROOT}/runtime-recomp/src/game/display_settings/*" "${DKRPORT_ROOT}/runtime-recomp/src/game/session_content/*")
  list(APPEND authored ${display_authored})
  list(APPEND authored "${DKRPORT_ROOT}/runtime-recomp/src/game/library_ui/startup_progress.hpp")
  list(APPEND authored ${driving_authored} "${DKRPORT_ROOT}/scripts/legacy_behaviour_policy.py" "${DKRPORT_ROOT}/scripts/generate_replay_probe.py")
  list(APPEND authored ${stability_authored} ${relay_authored} ${chat_authored} "${DKRPORT_ROOT}/runtime-recomp/cmake/OnlineStability.cmake" "${DKRPORT_ROOT}/runtime-recomp/cmake/PeerRelay.cmake" "${DKRPORT_ROOT}/runtime-recomp/cmake/SessionChat.cmake")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${authored} "${auth}/pipeline.py" "${auth}/ReleaseOverlay.cmake")
  execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${auth}/pipeline.py" --inputs "${stage}/inputs.json" --output "${stage}" RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
   message(FATAL_ERROR "Online performance staging failed")
  endif()
  file(READ "${stage}/swaps.json" swaps)
  string(JSON length LENGTH "${swaps}")
  math(EXPR last "${length}-1")
  foreach(index RANGE ${last})
   string(JSON target GET "${swaps}" ${index} target)
   string(JSON old GET "${swaps}" ${index} path)
   string(JSON next GET "${swaps}" ${index} new)
   get_target_property(directory ${target} SOURCE_DIR)
   foreach(property INCLUDE_DIRECTORIES COMPILE_OPTIONS COMPILE_DEFINITIONS)
    get_property(defined SOURCE "${old}" DIRECTORY "${directory}" PROPERTY ${property} SET)
    if(defined)
     get_property(value SOURCE "${old}" DIRECTORY "${directory}" PROPERTY ${property})
     set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY ${property} "${value}")
    endif()
   endforeach()
   get_filename_component(prior "${old}" DIRECTORY)
   get_property(includes SOURCE "${next}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES)
   set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES "${stage};${prior};${includes}")
   dkr_repair_replace_source(${target} "${old}" "${next}")
  endforeach()
  foreach(test DKRRaceReleaseChecks DKRSpectatorHandlerChecks)
   get_target_property(definitions ${test} COMPILE_DEFINITIONS)
   list(FILTER definitions EXCLUDE REGEX "^DKR_RACE_RELEASE_SOURCE=")
   list(APPEND definitions "DKR_RACE_RELEASE_SOURCE=\"${stage}/DKRPortGame/party_runtime.cpp\"")
   set_property(TARGET ${test} PROPERTY COMPILE_DEFINITIONS "${definitions}")
  endforeach()
  foreach(revision 77 80)
   add_executable(DKROnlineMenu${revision}Checks EXCLUDE_FROM_ALL "${stage}/DKRExperimentalOwnedGameV${revision}/menu_fixture.c")
   target_include_directories(DKROnlineMenu${revision}Checks PRIVATE "${stage}")
   add_executable(DKROnlineMenu${revision}BeforeChecks EXCLUDE_FROM_ALL "${stage}/DKRExperimentalOwnedGameV${revision}/menu_before_fixture.c")
  endforeach()
  add_executable(DKROnlineSetupChecks EXCLUDE_FROM_ALL "${auth}/tests/setup_checks.cpp")
  target_compile_features(DKROnlineSetupChecks PRIVATE cxx_std_20)
  target_compile_definitions(DKROnlineSetupChecks PRIVATE NOMINMAX)
  target_include_directories(DKROnlineSetupChecks PRIVATE "${stage}" "${cache_headers}")
  target_link_libraries(DKROnlineSetupChecks PRIVATE DKRLegacyModCore DKRUpdateInstall)
  add_executable(DKROnlinePartyChecks EXCLUDE_FROM_ALL "${stage}/party_checks.cpp")
  target_compile_features(DKROnlinePartyChecks PRIVATE cxx_std_20)
  get_target_property(includes DKRRaceReleaseChecks INCLUDE_DIRECTORIES)
  target_include_directories(DKROnlinePartyChecks PRIVATE ${includes} "${DKRPORT_ROOT}/runtime-recomp/tests")
  target_compile_definitions(DKROnlinePartyChecks PRIVATE "DKR_RACE_RELEASE_SOURCE=\"${stage}/DKRPortGame/party_runtime.cpp\"")
  target_link_libraries(DKROnlinePartyChecks PRIVATE DKRNetplayCore)
  target_include_directories(DKRDirectoryLifecycleChecks PRIVATE "${CMAKE_BINARY_DIR}/generated/online-directory" ${includes})
  get_target_property(links DKRPortGame LINK_DIRECTORIES)
  if(links)
   target_link_directories(DKROnlineSetupChecks PRIVATE ${links})
   target_link_directories(DKROnlinePartyChecks PRIVATE ${links})
   target_link_directories(DKRDirectoryLifecycleChecks PRIVATE ${links})
  endif()
  # Exact changes form part of the compatibility identity. Windows and Linux
  # peers must use this same playtest; an old peer cannot enter the new owner.
  set(ledger "online-performance-v1\n")
  list(APPEND authored "${auth}/pipeline.py" "${auth}/ReleaseOverlay.cmake")
  list(SORT authored)
  foreach(path IN LISTS authored)
   file(RELATIVE_PATH name "${auth}" "${path}")
   file(SHA256 "${path}" hash)
   string(APPEND ledger "${name}:${hash}\n")
  endforeach()
  get_target_property(definitions DKRExperimentalOwnedRegistry COMPILE_DEFINITIONS)
  set(updated "")
  set(contracts "{")
  set(separator "")
  foreach(value IN LISTS definitions)
   if(value MATCHES "^DKR_OWNED_BUILD_ID_V(77|80)=\"([a-f0-9]+)\"$")
    set(revision "${CMAKE_MATCH_1}")
    string(SHA256 hash "${CMAKE_MATCH_2}\n${ledger}")
    set(value "DKR_OWNED_BUILD_ID_V${revision}=\"${hash}\"")
    string(APPEND contracts "${separator}\"${revision}\":\"${hash}\"")
    set(separator ",")
   endif()
   list(APPEND updated "${value}")
  endforeach()
  if(separator STREQUAL "")
   message(FATAL_ERROR "Online performance peer contracts missing")
  endif()
  string(APPEND contracts "}")
  file(WRITE "${stage}/contracts.json" "${contracts}")
  set_property(TARGET DKRExperimentalOwnedRegistry PROPERTY COMPILE_DEFINITIONS "${updated}")
  if(DKR_RELEASE_EVIDENCE)
   file(WRITE "${DKR_RELEASE_EVIDENCE}/DKRExperimentalOwnedRegistry-COMPILE_DEFINITIONS.txt" "${updated}\n")
  endif()
 endfunction()
 cmake_language(DEFER CALL dkr_apply_online_performance)
endif()
