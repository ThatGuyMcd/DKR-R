# Stable version of the complete memory, rendering, handoff and vehicle repairs.
include("${CMAKE_CURRENT_LIST_DIR}/../../character-library-portraits/ReleaseOverlay.cmake")
if(PROJECT_NAME STREQUAL "DKRRuntimePreparation")
 file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/../../../VERSION" release_version LIMIT_COUNT 1)
 if(NOT DKR_RELEASE_VERSION STREQUAL release_version)
  message(FATAL_ERROR "The desktop release version must match VERSION")
 endif()
 if(ANDROID OR APPLE)
  message(FATAL_ERROR "The desktop release set is Windows and Linux only")
 endif()
 if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64|ARM64)$" AND CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
  function(dkr_release111_vehicle_numeric_alignment)
   get_target_property(sources DKRCustomVehicles SOURCES)
   list(FILTER sources INCLUDE REGEX "/vehicle-original-textures/DKRCustomVehicles/vehicle_package.cpp$")
   list(LENGTH sources count)
   if(NOT count EQUAL 1)
    message(FATAL_ERROR "Vehicle numeric alignment needs one final preparation source")
   endif()
   list(GET sources 0 source)
   get_target_property(directory DKRCustomVehicles SOURCE_DIR)
   set_property(SOURCE "${source}" DIRECTORY "${directory}" APPEND PROPERTY COMPILE_OPTIONS -ffp-contract=off)
   foreach(target DKRVehicleOriginalChecks DKRVehicleOriginalSanitizerChecks)
    if(TARGET ${target})
     target_compile_options(${target} PRIVATE -ffp-contract=off)
    endif()
   endforeach()
   file(WRITE "${CMAKE_BINARY_DIR}/generated/release111-vehicle-numeric-policy.json"
    "{\"scope\":\"ARM64 vehicle preparation and its synthetic fixtures only\",\"option\":\"-ffp-contract=off\",\"source\":\"${source}\"}\n")
  endfunction()
  cmake_language(DEFER CALL dkr_release111_vehicle_numeric_alignment)
 endif()
endif()
