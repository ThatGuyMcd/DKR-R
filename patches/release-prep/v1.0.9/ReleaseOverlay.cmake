# Stable release metadata/platform adapter over the owner-accepted lobby build.
include("${CMAKE_CURRENT_LIST_DIR}/../../online-directory/ReleaseOverlay.cmake")
if(PROJECT_NAME STREQUAL "DKRRuntimePreparation")
 if(ANDROID)
  # The older Android Store keeps relative includes. Supply the exact frozen
  # account-page input before running the unchanged directory composer.
  cmake_language(DEFER GET_CALL_IDS release109_calls)
  foreach(call_id IN LISTS release109_calls)
   cmake_language(DEFER GET_CALL "${call_id}" release109_call)
   list(GET release109_call 0 release109_function)
   if(release109_function STREQUAL "dkr_apply_online_directory")
    cmake_language(DEFER CANCEL_CALL "${call_id}")
   endif()
  endforeach()
  function(dkr_release109_directory)
   execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${DKRPORT_ROOT}/patches/release-prep/v1.0.9/android_account_input.py"
    --source "${DKR_MOD_STORE_STAGE}/native/src/game/store_account_page.inl"
    --generated "${CMAKE_BINARY_DIR}/generated/store-vehicles" --output "${CMAKE_BINARY_DIR}/generated/release109/account-inputs.json"
    RESULT_VARIABLE result)
   if(NOT result EQUAL 0)
    message(FATAL_ERROR "Android retained account-page input failed")
   endif()
   dkr_apply_online_directory()
  endfunction()
  cmake_language(DEFER CALL dkr_release109_directory)
 endif()
 function(dkr_release109_platform)
  if(NOT DKR_RELEASE_VERSION STREQUAL "1.0.9")
   message(FATAL_ERROR "The release layer requires the real stable 1.0.9 version")
  endif()
  if(ANDROID)
   set(auth "${DKRPORT_ROOT}/patches/release-prep/v1.0.9")
   set(stage "${CMAKE_BINARY_DIR}/generated/release109")
   set(old "${CMAKE_BINARY_DIR}/generated/online-directory/online_directory.cpp")
   execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${auth}/android_snapshot.py" --source "${old}" --output "${stage}" RESULT_VARIABLE result)
   if(NOT result EQUAL 0)
    message(FATAL_ERROR "Android directory snapshot adaptation failed")
   endif()
   set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${auth}/android_snapshot.py")
   dkr_repair_replace_source(DKRNetplayCore "${old}" "${stage}/online_directory.cpp")
   set(store "${CMAKE_BINARY_DIR}/generated/online-directory/mod_store.cpp")
   execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${auth}/android_http.py" --source "${store}" --output "${stage}" RESULT_VARIABLE result)
   if(NOT result EQUAL 0)
    message(FATAL_ERROR "Android authenticated directory HTTPS adaptation failed")
   endif()
   get_target_property(directory DKRPortGame SOURCE_DIR)
   foreach(property INCLUDE_DIRECTORIES COMPILE_OPTIONS COMPILE_DEFINITIONS)
    get_property(defined SOURCE "${store}" DIRECTORY "${directory}" PROPERTY ${property} SET)
    if(defined)
     get_property(value SOURCE "${store}" DIRECTORY "${directory}" PROPERTY ${property})
     set_property(SOURCE "${stage}/mod_store.cpp" DIRECTORY "${directory}" PROPERTY ${property} "${value}")
    endif()
   endforeach()
   dkr_repair_replace_source(DKRPortGame "${store}" "${stage}/mod_store.cpp")
   set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${auth}/android_http.py" "${auth}/android_account_input.py")
   execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${auth}/android_shared.py"
    --vehicles "${CMAKE_BINARY_DIR}/generated/custom-vehicles/native/vehicle_binding.cpp"
    --achievements "${CMAKE_BINARY_DIR}/generated/achievements/achievements.cpp" --output "${stage}" RESULT_VARIABLE result)
   if(NOT result EQUAL 0)
    message(FATAL_ERROR "Android vehicle/achievement snapshot adaptation failed")
   endif()
   execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${auth}/android_texture.py"
    --source "${CMAKE_BINARY_DIR}/generated/texture-dumping/texture_dump.cpp" --output "${stage}" RESULT_VARIABLE result)
   if(NOT result EQUAL 0)
    message(FATAL_ERROR "Android texture timestamp adaptation failed")
   endif()
   foreach(pair "DKRCustomVehicles|${CMAKE_BINARY_DIR}/generated/custom-vehicles/native/vehicle_binding.cpp" "DKRPortGame|${CMAKE_BINARY_DIR}/generated/achievements/achievements.cpp" "DKRPortGame|${CMAKE_BINARY_DIR}/generated/texture-dumping/texture_dump.cpp")
    string(REPLACE "|" ";" fields "${pair}")
    list(GET fields 0 target)
    list(GET fields 1 source)
    get_filename_component(name "${source}" NAME)
    get_target_property(directory ${target} SOURCE_DIR)
    foreach(property INCLUDE_DIRECTORIES COMPILE_OPTIONS COMPILE_DEFINITIONS)
     get_property(defined SOURCE "${source}" DIRECTORY "${directory}" PROPERTY ${property} SET)
     if(defined)
      get_property(value SOURCE "${source}" DIRECTORY "${directory}" PROPERTY ${property})
      set_property(SOURCE "${stage}/${name}" DIRECTORY "${directory}" PROPERTY ${property} "${value}")
     endif()
    endforeach()
    get_filename_component(source_parent "${source}" DIRECTORY)
    set_property(SOURCE "${stage}/${name}" DIRECTORY "${directory}" APPEND PROPERTY INCLUDE_DIRECTORIES "${source_parent}")
    dkr_repair_replace_source(${target} "${source}" "${stage}/${name}")
   endforeach()
   set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${auth}/android_shared.py")
   set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${auth}/android_texture.py")
  endif()
 endfunction()
 cmake_language(DEFER CALL dkr_release109_platform)
endif()
