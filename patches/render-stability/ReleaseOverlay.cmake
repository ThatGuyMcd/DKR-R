include("${CMAKE_CURRENT_LIST_DIR}/../memory-stability/ReleaseOverlay.cmake")
if(PROJECT_NAME STREQUAL "DKRRuntimePreparation")
 function(dkr_apply_render_stability)
  set(auth "${DKRPORT_ROOT}/patches/render-stability")
  set(stage "${CMAKE_BINARY_DIR}/generated/render-stability")
  file(MAKE_DIRECTORY "${stage}")
  set(rows "[")
  set(separator "")
  foreach(entry "DKRPortGame|f3ddkr_rt64.cpp" "DKRPortGame|rt64_renderer.cpp" "DKRPortGame|online_view_rt64.cpp"
    "DKRNetplayCore|experimental_present_gate.cpp" "DKRPortGame|experimental_present_gate.cpp"
    "rt64|rt64_texture_cache.cpp" "rt64|rt64_framebuffer_renderer.cpp"
    "rt64|rt64_state.cpp" "rt64|rt64_workload_queue.cpp" "rt64|rt64_present_queue.cpp")
   string(REPLACE "|" ";" fields "${entry}")
   list(GET fields 0 target)
   list(GET fields 1 name)
   get_target_property(paths ${target} SOURCES)
   list(FILTER paths INCLUDE REGEX "[/\\]${name}$")
   list(LENGTH paths count)
   if(NOT count EQUAL 1)
    message(FATAL_ERROR "Render repair needs one final ${target}/${name}")
   endif()
   list(GET paths 0 path)
   file(TO_CMAKE_PATH "${path}" path)
   get_target_property(directory ${target} SOURCE_DIR)
   get_property(source_includes SOURCE "${path}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES)
   get_target_property(target_includes ${target} INCLUDE_DIRECTORIES)
   get_filename_component(parent "${path}" DIRECTORY)
   set(includes "[")
   set(comma "")
   foreach(candidate IN ITEMS "${parent}" ${source_includes} ${target_includes})
    if(IS_DIRECTORY "${candidate}")
     file(TO_CMAKE_PATH "${candidate}" candidate)
     string(APPEND includes "${comma}\"${candidate}\"")
     set(comma ",")
    endif()
   endforeach()
   string(APPEND includes "]")
   string(APPEND rows "${separator}{\"target\":\"${target}\",\"path\":\"${path}\",\"includes\":${includes}}")
   set(separator ",")
  endforeach()
  string(APPEND rows "]")
  file(WRITE "${stage}/inputs.json" "${rows}")
  file(GLOB authored CONFIGURE_DEPENDS "${auth}/native/*" "${auth}/tests/*.cpp" "${auth}/tests/stubs/*.hpp" "${auth}/tests/stubs/render/*.h")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${authored} "${auth}/pipeline.py" "${auth}/ReleaseOverlay.cmake" "${DKRPORT_ROOT}/patches/camera-plus/integration_pipeline.py")
  execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${auth}/pipeline.py" --inputs "${stage}/inputs.json" --output "${stage}" RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
   message(FATAL_ERROR "Render stability staging failed")
  endif()
  file(READ "${stage}/swaps.json" swaps)
  string(JSON count LENGTH "${swaps}")
  math(EXPR last "${count}-1")
  foreach(index RANGE ${last})
   string(JSON target GET "${swaps}" ${index} target)
   string(JSON old GET "${swaps}" ${index} path)
   string(JSON next GET "${swaps}" ${index} new)
   get_target_property(directory ${target} SOURCE_DIR)
   foreach(property INCLUDE_DIRECTORIES COMPILE_OPTIONS COMPILE_DEFINITIONS)
    get_property(defined SOURCE "${old}" DIRECTORY "${directory}" PROPERTY ${property} SET)
    if(defined)
     get_property(value SOURCE "${old}" DIRECTORY "${directory}" PROPERTY ${property})
     set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY ${property} "${value}")
    endif()
   endforeach()
   get_filename_component(prior "${old}" DIRECTORY)
   get_property(includes SOURCE "${next}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES)
   set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES "${stage};${prior};${prior}/..;${includes}")
   dkr_repair_replace_source(${target} "${old}" "${next}")
  endforeach()
  # The gate is deliberately also supplied as an RT64 interface source for
  # static-link consumers. Keep that source and explicit consumer copies on
  # the same final implementation; otherwise the new query pulls a second
  # complete gate object from DKRNetplayCore and duplicates every gate symbol.
  set(gate "${stage}/DKRPortGame/experimental_present_gate.cpp")
  get_target_property(interface_sources rt64 INTERFACE_SOURCES)
  set(updated_interface "")
  foreach(path IN LISTS interface_sources)
   get_filename_component(leaf "${path}" NAME)
   if(leaf STREQUAL "experimental_present_gate.cpp")
    list(APPEND updated_interface "${gate}")
   else()
    list(APPEND updated_interface "${path}")
   endif()
  endforeach()
  set_property(TARGET rt64 PROPERTY INTERFACE_SOURCES "${updated_interface}")
  get_property(consumers DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
  foreach(consumer IN LISTS consumers)
   get_target_property(paths ${consumer} SOURCES)
   foreach(path IN LISTS paths)
    get_filename_component(leaf "${path}" NAME)
    file(TO_CMAKE_PATH "${path}" normalized)
    if(leaf STREQUAL "experimental_present_gate.cpp" AND NOT normalized STREQUAL "${gate}" AND
       NOT normalized STREQUAL "${stage}/DKRNetplayCore/experimental_present_gate.cpp")
     dkr_repair_replace_source(${consumer} "${path}" "${gate}")
    endif()
   endforeach()
  endforeach()
  foreach(target DKRPortGame rt64)
   get_target_property(paths ${target} SOURCES)
   if(DKR_RELEASE_EVIDENCE)
    file(WRITE "${DKR_RELEASE_EVIDENCE}/${target}-RENDER-REPAIR-SOURCES.txt" "${paths}\n")
   endif()
  endforeach()
  add_executable(DKRRenderStabilityChecks EXCLUDE_FROM_ALL "${auth}/tests/selection_tests.cpp")
  target_compile_features(DKRRenderStabilityChecks PRIVATE cxx_std_20)
  target_include_directories(DKRRenderStabilityChecks PRIVATE "${stage}")
  add_executable(DKRLiquidResidencyChecks EXCLUDE_FROM_ALL "${auth}/tests/residency_tests.cpp")
  target_compile_features(DKRLiquidResidencyChecks PRIVATE cxx_std_20)
  target_include_directories(DKRLiquidResidencyChecks PRIVATE "${auth}/tests/stubs")
 endfunction()
 cmake_language(DEFER CALL dkr_apply_render_stability)
endif()
