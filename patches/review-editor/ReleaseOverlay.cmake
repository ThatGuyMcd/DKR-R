# Outermost, opt-in UI composition over the accepted baseline + startup hotfix.
include("${CMAKE_CURRENT_LIST_DIR}/../release-prep/v1.0.7/ReleaseOverlay.cmake")
if(PROJECT_NAME STREQUAL "DKRRuntimePreparation")
    function(dkr_apply_review_editor)
        get_target_property(game_sources DKRPortGame SOURCES)
        set(ui_sources ${game_sources})
        list(FILTER ui_sources INCLUDE REGEX "/runtime_ui\\.cpp$")
        list(LENGTH ui_sources count)
        if(NOT count EQUAL 1)
            message(FATAL_ERROR "Expected one final launcher source")
        endif()
        list(GET ui_sources 0 ui)
        get_target_property(renderer_sources rt64 SOURCES)
        set(widget_sources ${renderer_sources})
        list(FILTER widget_sources INCLUDE REGEX "/imgui_widgets\\.cpp$")
        list(LENGTH widget_sources count)
        if(NOT count EQUAL 1)
            message(FATAL_ERROR "Expected one ImGui widgets source")
        endif()
        list(GET widget_sources 0 widgets)
        set(stage "${CMAKE_BINARY_DIR}/generated/review-editor")
        file(GLOB authored CONFIGURE_DEPENDS "${DKRPORT_ROOT}/patches/review-editor/native/*.inl")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
            "${DKRPORT_ROOT}/patches/review-editor/pipeline.py" ${authored})
        execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${DKRPORT_ROOT}/patches/review-editor/pipeline.py"
            --ui "${ui}" --store "${DKR_MOD_STORE_STAGE}/native/src/game"
            --widgets "${widgets}" --output "${stage}" RESULT_VARIABLE result)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Review editor Patch Pipeline composition failed")
        endif()
        foreach(target DKRPortGame rt64)
            if(target STREQUAL "DKRPortGame")
                set(old "${ui}")
                set(next "${stage}/native/runtime_ui.cpp")
                set(sources ${game_sources})
                set(extra "${stage}/native;${DKR_MOD_STORE_STAGE}/native/src/game")
            else()
                set(old "${widgets}")
                set(next "${stage}/renderer/imgui_widgets.cpp")
                set(sources ${renderer_sources})
                set(extra "${stage}/renderer")
            endif()
            get_target_property(directory ${target} SOURCE_DIR)
            foreach(property INCLUDE_DIRECTORIES COMPILE_OPTIONS COMPILE_DEFINITIONS)
                get_property(defined SOURCE "${old}" DIRECTORY "${directory}" PROPERTY ${property} SET)
                if(defined)
                    get_property(value SOURCE "${old}" DIRECTORY "${directory}" PROPERTY ${property})
                    set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY ${property} "${value}")
                endif()
            endforeach()
            get_filename_component(prior "${old}" DIRECTORY)
            get_property(includes SOURCE "${next}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES)
            set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES "${extra};${prior};${includes}")
            list(REMOVE_ITEM sources "${old}")
            list(APPEND sources "${next}")
            set_property(TARGET ${target} PROPERTY SOURCES "${sources}")
            file(WRITE "${DKR_RELEASE_EVIDENCE}/${target}-REVIEW-EDITOR-SOURCES.txt" "${sources}\n")
        endforeach()
    endfunction()
    cmake_language(DEFER CALL dkr_apply_review_editor)
endif()
