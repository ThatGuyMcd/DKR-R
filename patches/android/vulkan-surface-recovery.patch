     bool VulkanSwapChain::resize() {
+        dkr::runtime::android_surface::Lease lease;
+        if (!lease.window) return false;
+        if (lease.generation != androidSurfaceGeneration || androidSurfaceLost) {
+            // Called by PresentQueue only after its framebuffer fence and
+            // framebuffer references are drained. Also retire presentation
+            // queue operations before destroying the old surface/swapchain.
+            VkResult idle;
+            {
+                const std::scoped_lock queueLock(*commandQueue->queue->mutex);
+                idle = vkQueueWaitIdle(commandQueue->queue->vk);
+            }
+            if (idle != VK_SUCCESS) {
+                dkr::runtime::graphics_health::record(dkr::runtime::graphics_health::Stage::Fence, idle);
+                return false;
+            }
+            releaseImageViews(); releaseSwapChain();
+            auto* renderInterface = commandQueue->device->renderInterface;
+            if (surface != VK_NULL_HANDLE) vkDestroySurfaceKHR(renderInterface->instance, surface, nullptr);
+            surface = VK_NULL_HANDLE;
+            if (androidWindowOwned) ANativeWindow_release(desc.renderWindow);
+            desc.renderWindow = lease.window; ANativeWindow_acquire(desc.renderWindow);
+            androidWindowOwned = true;
+            VkAndroidSurfaceCreateInfoKHR info{};
+            info.sType = VK_STRUCTURE_TYPE_ANDROID_SURFACE_CREATE_INFO_KHR;
+            info.window = desc.renderWindow;
+            const auto result = vkCreateAndroidSurfaceKHR(renderInterface->instance, &info, nullptr, &surface);
+            if (result != VK_SUCCESS) {
+                dkr::runtime::graphics_health::record(dkr::runtime::graphics_health::Stage::Surface, result);
+                return false;
+            }
+            androidSurfaceGeneration = lease.generation;
+            androidSurfaceLost = false;
+            androidRequestedRate = 0;
+            currentPresentId = 0;
+            fprintf(stderr, "[Android] Recreated native presentation surface generation=%llu\n",
+                static_cast<unsigned long long>(androidSurfaceGeneration));
+        }
