     void VulkanDevice::release() {
+        if (pipelineCache != VK_NULL_HANDLE && vk != VK_NULL_HANDLE) {
+            using namespace dkr::runtime::android_pipeline_cache;
+            // Application teardown joins all pipeline creators first. Never
+            // write a cache after a GPU failure, or serialize in a frame loop.
+            try { if (!dkr::runtime::graphics_health::failed()) {
+                std::size_t size = 0;
+                if (vkGetPipelineCacheData(vk, pipelineCache, &size, nullptr) == VK_SUCCESS &&
+                    size >= 32 && size <= maximum_bytes) {
+                    std::vector<std::uint8_t> data(size);
+                    if (vkGetPipelineCacheData(vk, pipelineCache, &size, data.data()) == VK_SUCCESS) {
+                        data.resize(size);
+                        Identity id{physicalDeviceProperties.vendorID, physicalDeviceProperties.deviceID,
+                                    physicalDeviceProperties.driverVersion, {}};
+                        std::copy_n(physicalDeviceProperties.pipelineCacheUUID, id.uuid.size(), id.uuid.begin());
+                        fprintf(stderr, "[Android] Pipeline cache saved=%u bytes=%zu\n", save(id, data) ? 1U : 0U, size);
+                    }
+                }
+            } } catch (...) {
+                // Optional cache serialization must not make teardown fail
+                // under memory pressure. The previous cache remains usable.
+                fprintf(stderr, "[Android] Pipeline cache save skipped\n");
+            }
+            vkDestroyPipelineCache(vk, pipelineCache, nullptr);
+            pipelineCache = VK_NULL_HANDLE;
+        }
