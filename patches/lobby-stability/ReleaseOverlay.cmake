include("${CMAKE_CURRENT_LIST_DIR}/../music-preview-repair/ReleaseOverlay.cmake")
if(PROJECT_NAME STREQUAL "DKRRuntimePreparation")
 function(dkr_apply_lobby_stability)
  set(auth "${DKRPORT_ROOT}/patches/lobby-stability")
  set(stage "${CMAKE_BINARY_DIR}/generated/lobby-stability")
  file(MAKE_DIRECTORY "${stage}")
  set(rows "[")
  set(separator "")
  foreach(pair "DKRLegacyImportLibrary|online_mod_sync.cpp" "DKRLegacyImportLibrary|online_mod_profile.cpp"
               "DKRNetplayCore|direct_session.cpp" "DKRPortGame|runtime_ui.cpp" "DKRPortGame|game_main.cpp" "DKRPortGame|runtime_stubs.cpp")
   string(REPLACE "|" ";" fields "${pair}")
   list(GET fields 0 target)
   list(GET fields 1 name)
   get_target_property(paths ${target} SOURCES)
   list(FILTER paths INCLUDE REGEX "[/\\]${name}$")
   list(LENGTH paths count)
   if(NOT count EQUAL 1)
    message(FATAL_ERROR "Lobby stability needs one final ${target}/${name}")
   endif()
   list(GET paths 0 path)
   file(TO_CMAKE_PATH "${path}" path)
   string(APPEND rows "${separator}{\"target\":\"${target}\",\"path\":\"${path}\"}")
   set(separator ",")
  endforeach()
  string(APPEND rows "]")
  file(WRITE "${stage}/inputs.json" "${rows}")
  get_target_property(task_paths librecomp SOURCES)
  list(FILTER task_paths INCLUDE REGEX "[/\\]sp[.]cpp$")
  list(LENGTH task_paths task_count)
  if(NOT task_count EQUAL 1)
   message(FATAL_ERROR "Need one unchanged SDK task submission source")
  endif()
  list(GET task_paths 0 task_source)
  file(TO_CMAKE_PATH "${task_source}" task_source)
  file(GLOB authored CONFIGURE_DEPENDS "${auth}/native/*")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${authored} "${auth}/pipeline.py" "${auth}/transforms.py" "${auth}/ReleaseOverlay.cmake")
  execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${auth}/pipeline.py"
   --inputs "${stage}/inputs.json" --output "${stage}" --task-source "${task_source}" RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
   message(FATAL_ERROR "Lobby stability could not stage")
  endif()
  file(READ "${stage}/swaps.json" swaps)
  foreach(index RANGE 5)
   string(JSON target GET "${swaps}" ${index} target)
   string(JSON old GET "${swaps}" ${index} path)
   string(JSON next GET "${swaps}" ${index} new)
   get_target_property(directory ${target} SOURCE_DIR)
   foreach(property INCLUDE_DIRECTORIES COMPILE_OPTIONS COMPILE_DEFINITIONS)
    get_property(defined SOURCE "${old}" DIRECTORY "${directory}" PROPERTY ${property} SET)
    if(defined)
     get_property(value SOURCE "${old}" DIRECTORY "${directory}" PROPERTY ${property})
     set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY ${property} "${value}")
    endif()
   endforeach()
   get_filename_component(prior "${old}" DIRECTORY)
   get_property(includes SOURCE "${next}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES)
   set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES "${stage};${prior};${includes}")
   dkr_repair_replace_source(${target} "${old}" "${next}")
  endforeach()
  get_target_property(task_directory librecomp SOURCE_DIR)
  set_property(SOURCE "${stage}/task_submission.cpp" DIRECTORY "${task_directory}" PROPERTY INCLUDE_DIRECTORIES "${stage}")
  if(MSVC)
   # This C ABI forwards C++ failures and owns a scoped permission. /EHc
   # would let MSVC assume the delegated C entrypoint cannot throw and skip
   # the required scope unwind; match the existing owned runtime adapters.
   set_property(SOURCE "${stage}/task_submission.cpp" DIRECTORY "${task_directory}" APPEND PROPERTY COMPILE_OPTIONS /EHs /EHc-)
  endif()
  dkr_repair_replace_source(librecomp "${task_source}" "${stage}/task_submission.cpp")
  add_executable(DKRStabilityTransferChecks EXCLUDE_FROM_ALL "${stage}/transfer_checks.cpp")
  target_link_libraries(DKRStabilityTransferChecks PRIVATE DKRLegacyModCore)
  target_include_directories(DKRStabilityTransferChecks PRIVATE "${stage}")
  get_target_property(test_link_directories DKRPortGame LINK_DIRECTORIES)
  if(test_link_directories)
   target_link_directories(DKRStabilityTransferChecks PRIVATE ${test_link_directories})
  endif()
  set(ledger "bounded-mod-admission-v1\n")
  foreach(path "${auth}/pipeline.py" "${auth}/transforms.py" "${auth}/ReleaseOverlay.cmake" ${authored})
   get_filename_component(name "${path}" NAME)
   file(SHA256 "${path}" hash)
   string(APPEND ledger "${name}:${hash}\n")
  endforeach()
  file(SHA256 "${task_source}" delegated_hash)
  string(APPEND ledger "delegated-sdk-task-source:${delegated_hash}\n")
  string(SHA256 contract "${ledger}")
  file(WRITE "${stage}/build_contract.hpp" "#pragma once\n#define DKR_LOBBY_STABILITY_CONTRACT \"${contract}\"\n")
  get_target_property(definitions DKRExperimentalOwnedRegistry COMPILE_DEFINITIONS)
  set(updated "")
  set(contracts "{")
  set(separator "")
  foreach(value IN LISTS definitions)
   if(value MATCHES "^DKR_OWNED_BUILD_ID_V(77|80)=\"([a-f0-9]+)\"$")
    set(revision "${CMAKE_MATCH_1}")
    string(SHA256 hash "${CMAKE_MATCH_2}\n${ledger}")
    set(value "DKR_OWNED_BUILD_ID_V${revision}=\"${hash}\"")
    string(APPEND contracts "${separator}\"${revision}\":\"${hash}\"")
    set(separator ",")
   endif()
   list(APPEND updated "${value}")
  endforeach()
  if(separator STREQUAL "")
   message(FATAL_ERROR "Lobby stability peer contracts missing")
  endif()
  string(APPEND contracts "}")
  file(WRITE "${stage}/contracts.json" "${contracts}")
  file(WRITE "${stage}/contract.txt" "${contract}\n")
  set_property(TARGET DKRExperimentalOwnedRegistry PROPERTY COMPILE_DEFINITIONS "${updated}")
  if(DKR_RELEASE_EVIDENCE)
   file(WRITE "${DKR_RELEASE_EVIDENCE}/DKRExperimentalOwnedRegistry-COMPILE_DEFINITIONS.txt" "${updated}\n")
  endif()
 endfunction()
 cmake_language(DEFER CALL dkr_apply_lobby_stability)
endif()
