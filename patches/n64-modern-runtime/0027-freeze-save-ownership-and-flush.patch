-void ultramodern::init_saving(RDRAM_ARG1) {
-    while (save_context.write_sempahore.tryWait()) {}
-    while (save_context.swap_file_pending_sempahore.tryWait()) {}
-    while (save_context.swap_file_ready_sempahore.tryWait()) {}
