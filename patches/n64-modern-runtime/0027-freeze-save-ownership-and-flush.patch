-    set_save_file_path(u8"", recomp::current_game_id());
-
-    save_context.save_buffer.resize(get_save_size(recomp::get_save_type()));
-
-    read_save_file();
-
-    save_context.saving_thread = std::thread{saving_thread_func, PASS_RDRAM};
