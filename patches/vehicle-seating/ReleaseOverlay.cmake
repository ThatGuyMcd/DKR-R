# Keep the accepted Magic Code and drawing-heap repair in this delivery.
# Vehicle authoring is composed upstream into isolated native source copies.
include("${CMAKE_CURRENT_LIST_DIR}/../mod-runtime-repair/ReleaseOverlay.cmake")
if(PROJECT_NAME STREQUAL "DKRRuntimePreparation")
    function(dkr_apply_driver_detail)
        set(auth "${DKRPORT_ROOT}/patches/vehicle-seating")
        set(stage "${CMAKE_BINARY_DIR}/generated/vehicle-seating")
        file(MAKE_DIRECTORY "${stage}")
        set(records "[")
        set(separator "")
        foreach(pair "DKRPortGame|local_model_rt64.cpp" "DKRPortGame|runtime_stubs.cpp" "DKRPortGame|f3ddkr_rt64.cpp" "DKRPortGame|runtime_enhancements.cpp"
                "DKRLocalModelV77|visual_model_kernel.c" "DKRLocalModelV80|visual_model_kernel.c"
                "DKRExperimentalOwnedGameV77|probe_native.c" "DKRExperimentalOwnedGameV80|probe_native.c")
            string(REPLACE "|" ";" fields "${pair}")
            list(GET fields 0 target)
            list(GET fields 1 name)
            get_target_property(paths ${target} SOURCES)
            list(FILTER paths INCLUDE REGEX "/${name}$")
            list(LENGTH paths count)
            if(NOT count EQUAL 1)
                message(FATAL_ERROR "Driver detail needs one final ${target}/${name}")
            endif()
            list(GET paths 0 path)
            file(TO_CMAKE_PATH "${path}" path)
            string(APPEND records "${separator}{\"target\":\"${target}\",\"path\":\"${path}\"}")
            set(separator ",")
        endforeach()
        foreach(target DKRRecompiledFuncsV77 DKRRecompiledFuncsV80 DKRExperimentalOwnedGameV77 DKRExperimentalOwnedGameV80)
            get_target_property(paths ${target} SOURCES)
            foreach(path IN LISTS paths)
                if(path MATCHES "\\.c$")
                    file(TO_CMAKE_PATH "${path}" path)
                    string(APPEND records "${separator}{\"target\":\"${target}\",\"path\":\"${path}\",\"guest\":true}")
                    set(separator ",")
                endif()
            endforeach()
        endforeach()
        string(APPEND records "]")
        file(WRITE "${stage}/inputs.json" "${records}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${auth}/driver_detail_pipeline.py" "${auth}/ReleaseOverlay.cmake")
        execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${auth}/driver_detail_pipeline.py"
            --inputs "${stage}/inputs.json" --output "${stage}" RESULT_VARIABLE result)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Driver detail and end-race tint composition failed")
        endif()
        file(READ "${stage}/swaps.json" swaps)
        string(JSON count LENGTH "${swaps}")
        math(EXPR last "${count}-1")
        foreach(index RANGE ${last})
            string(JSON target GET "${swaps}" ${index} target)
            string(JSON old GET "${swaps}" ${index} path)
            string(JSON next GET "${swaps}" ${index} new)
            get_target_property(directory ${target} SOURCE_DIR)
            foreach(property INCLUDE_DIRECTORIES COMPILE_OPTIONS COMPILE_DEFINITIONS)
                get_property(defined SOURCE "${old}" DIRECTORY "${directory}" PROPERTY ${property} SET)
                if(defined)
                    get_property(value SOURCE "${old}" DIRECTORY "${directory}" PROPERTY ${property})
                    set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY ${property} "${value}")
                endif()
            endforeach()
            get_filename_component(prior "${old}" DIRECTORY)
            set_property(SOURCE "${next}" DIRECTORY "${directory}" APPEND PROPERTY INCLUDE_DIRECTORIES
                "${CMAKE_BINARY_DIR}/generated/custom-vehicles/native" "${prior}")
            dkr_repair_replace_source(${target} "${old}" "${next}")
        endforeach()
        # Native residency is deterministic on every peer; local quality only
        # selects what to display. Extend, never replace, the accepted IDs.
        set(ledger "driver-detail-and-postrace-lens-v2\n")
        foreach(name driver_detail_pipeline.py ReleaseOverlay.cmake)
            file(SHA256 "${auth}/${name}" hash)
            string(APPEND ledger "${name}:${hash}\n")
        endforeach()
        get_target_property(definitions DKRExperimentalOwnedRegistry COMPILE_DEFINITIONS)
        set(updated "")
        set(contracts "{")
        set(separator "")
        foreach(value IN LISTS definitions)
            if(value MATCHES "^DKR_OWNED_BUILD_ID_V(77|80)=\"([a-f0-9]+)\"$")
                set(revision "${CMAKE_MATCH_1}")
                string(SHA256 hash "${CMAKE_MATCH_2}\n${ledger}")
                set(value "DKR_OWNED_BUILD_ID_V${revision}=\"${hash}\"")
                string(APPEND contracts "${separator}\"${revision}\":\"${hash}\"")
                set(separator ",")
            endif()
            list(APPEND updated "${value}")
        endforeach()
        if(separator STREQUAL "")
            message(FATAL_ERROR "Driver detail did not extend peer compatibility IDs")
        endif()
        string(APPEND contracts "}")
        file(WRITE "${stage}/driver-contracts.json" "${contracts}")
        set_property(TARGET DKRExperimentalOwnedRegistry PROPERTY COMPILE_DEFINITIONS "${updated}")
        if(DKR_RELEASE_EVIDENCE)
            file(WRITE "${DKR_RELEASE_EVIDENCE}/DKRExperimentalOwnedRegistry-COMPILE_DEFINITIONS.txt" "${updated}\n")
        endif()
    endfunction()
    cmake_language(DEFER CALL dkr_apply_driver_detail)
endif()
