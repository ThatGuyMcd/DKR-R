# Authored features are composed over the accepted release and review editor.
# No checked-out dependency or existing generated payload is modified.
include("${CMAKE_CURRENT_LIST_DIR}/../review-editor/ReleaseOverlay.cmake")
if(PROJECT_NAME STREQUAL "DKRRuntimePreparation")
    function(dkr_apply_custom_vehicles)
        set(auth "${DKRPORT_ROOT}/patches/custom-vehicles")
        set(stage "${CMAKE_BINARY_DIR}/generated/custom-vehicles")
        get_target_property(vehicle_driver_sources DKRExperimentalOwnedGameV77 SOURCES)
        list(FILTER vehicle_driver_sources INCLUDE REGEX "/probe_driver\\.cpp$")
        list(LENGTH vehicle_driver_sources driver_count)
        if(NOT driver_count EQUAL 1)
            message(FATAL_ERROR "Expected one final confirmed-scene driver")
        endif()
        list(GET vehicle_driver_sources 0 vehicle_driver)
        get_target_property(game_sources DKRPortGame SOURCES)
        set(ui_sources ${game_sources})
        list(FILTER ui_sources INCLUDE REGEX "/runtime_ui\\.cpp$")
        list(LENGTH ui_sources count)
        if(NOT count EQUAL 1)
            message(FATAL_ERROR "Expected exactly one final launcher source for vehicles")
        endif()
        list(GET ui_sources 0 ui)
        foreach(pair "DKRLegacyModLaunch|legacy_mod_launch.cpp|launch" "DKRPortGame|runtime_legacy_mods.cpp|runtime" "DKRPortGame|f3ddkr_rt64.cpp|bridge" "DKRPortGame|rt64_renderer.cpp|renderer"
            "DKRLegacyModCore|online_mod_manifest.cpp|manifest" "DKRLegacyImportLibrary|online_mod_profile.cpp|profile" "DKRLegacyModLaunch|online_mod_runtime.cpp|online_runtime"
            "rt64|rt64_state.cpp|rt64_state" "rt64|rt64_transform_processor.cpp|rt64_transform" "DKRLegacyModCore|legacy_asset_bus.cpp|asset_bus")
            string(REPLACE "|" ";" fields "${pair}")
            list(GET fields 0 target)
            list(GET fields 1 filename)
            list(GET fields 2 key)
            get_target_property(sources ${target} SOURCES)
            set(selected ${sources})
            list(FILTER selected INCLUDE REGEX "/${filename}$")
            list(LENGTH selected count)
            if(NOT count EQUAL 1)
                message(FATAL_ERROR "Expected one final ${filename} for vehicle composition")
            endif()
            list(GET selected 0 path)
            set(vehicle_${key} "${path}")
        endforeach()
        file(GLOB authored CONFIGURE_DEPENDS "${auth}/native/*")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
            "${auth}/pipeline.py" "${auth}/online_pipeline.py" "${auth}/music_pipeline.py" "${auth}/guest_pipeline.py" ${authored})
        execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${auth}/pipeline.py"
            --output "${stage}" --ui "${ui}"
            --library "${DKR_SDK2_REUSE_STAGE}/native/src/game/runtime_mod_library_ui.inl"
            --sdk "${DKR_SDK2_REUSE_STAGE}/modding"
            --launch "${vehicle_launch}" --runtime "${vehicle_runtime}" --bridge "${vehicle_bridge}" --renderer "${vehicle_renderer}"
            --manifest "${vehicle_manifest}" --profile "${vehicle_profile}" --online-runtime "${vehicle_online_runtime}"
            --rt64-state "${vehicle_rt64_state}"
            --rt64-transform "${vehicle_rt64_transform}"
            --driver "${vehicle_driver}"
            --asset-bus "${vehicle_asset_bus}"
            RESULT_VARIABLE result)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Custom vehicle Patch Pipeline composition failed")
        endif()
        add_library(DKRCustomVehicles STATIC
            "${stage}/native/vehicle_package.cpp"
            "${stage}/native/vehicle_library.cpp"
            "${stage}/native/vehicle_resources.cpp"
            "${stage}/native/vehicle_binding.cpp")
        target_compile_features(DKRCustomVehicles PUBLIC cxx_std_20)
        target_compile_definitions(DKRCustomVehicles PRIVATE NOMINMAX)
        target_include_directories(DKRCustomVehicles PUBLIC "${stage}/native"
            "${DKRPORT_ROOT}/runtime-recomp/src/game"
            "${DKRPORT_ROOT}/runtime-recomp/src/game/mods"
            "${DKR_DEPENDENCIES_DIR}/rt64/src/contrib"
            "${DKR_DEPENDENCIES_DIR}/n64-modern-runtime/thirdparty")
        target_link_libraries(DKRCustomVehicles PUBLIC DKRCustomMagicCodes DKRLegacyModCore)
        target_include_directories(DKRLegacyModCore PRIVATE "${stage}/native")
        target_link_libraries(DKRLegacyImportLibrary PRIVATE DKRCustomVehicles)
        target_link_libraries(DKRPortGame PRIVATE DKRCustomVehicles)
        foreach(camera_target DKRCameraSceneV77 DKRCameraSceneV80)
            if(TARGET ${camera_target})
                target_include_directories(${camera_target} PRIVATE "${DKRPORT_ROOT}/runtime-recomp/src/game")
            endif()
        endforeach()
        target_sources(DKRPortGame PRIVATE "${stage}/native/vehicle_world.cpp" "${stage}/native/vehicle_rt64.cpp")
        target_link_libraries(DKRLegacyModLaunch PRIVATE DKRCustomVehicles)
        target_sources(DKRLegacyModLaunch PRIVATE "${stage}/native/resident_music.cpp")
        target_include_directories(DKRLegacyModLaunch PRIVATE "${stage}/native" "${DKR_SDK2_REUSE_STAGE}/native/src/game")
        foreach(target DKRExperimentalOwnedGameV77 DKRExperimentalOwnedGameV80)
            get_target_property(sources ${target} SOURCES)
            set(selected ${sources})
            list(FILTER selected INCLUDE REGEX "/probe_driver\\.cpp$")
            list(LENGTH selected count)
            if(NOT count EQUAL 1)
                message(FATAL_ERROR "Expected one owned scene driver for ${target}")
            endif()
            list(GET selected 0 old)
            if(NOT old STREQUAL vehicle_driver)
                message(FATAL_ERROR "Owned revisions use different scene driver source inputs")
            endif()
            get_target_property(directory ${target} SOURCE_DIR)
            set(next "${stage}/native/probe_driver.cpp")
            foreach(property INCLUDE_DIRECTORIES COMPILE_OPTIONS COMPILE_DEFINITIONS)
                get_property(defined SOURCE "${old}" DIRECTORY "${directory}" PROPERTY ${property} SET)
                if(defined)
                    get_property(value SOURCE "${old}" DIRECTORY "${directory}" PROPERTY ${property})
                    set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY ${property} "${value}")
                endif()
            endforeach()
            get_filename_component(prior "${old}" DIRECTORY)
            get_property(includes SOURCE "${next}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES)
            # The driver's adjacent owned_game.hpp contains the accepted
            # confirmed-records ABI. Preserve quote-include precedence when
            # relocating the TU; an older SDK header must not shadow it.
            set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES
                "${stage}/native;${prior};${includes};${DKR_SDK2_REUSE_STAGE}/native/src/game")
            list(REMOVE_ITEM sources "${old}")
            list(APPEND sources "${next}")
            set_property(TARGET ${target} PROPERTY SOURCES "${sources}")
        endforeach()
        foreach(pair "DKRLegacyModLaunch|${vehicle_launch}" "DKRPortGame|${vehicle_runtime}" "DKRPortGame|${vehicle_bridge}" "DKRPortGame|${vehicle_renderer}"
            "DKRLegacyModCore|${vehicle_manifest}" "DKRLegacyImportLibrary|${vehicle_profile}" "DKRLegacyModLaunch|${vehicle_online_runtime}" "rt64|${vehicle_rt64_state}" "rt64|${vehicle_rt64_transform}" "DKRLegacyModCore|${vehicle_asset_bus}")
            string(REPLACE "|" ";" fields "${pair}")
            list(GET fields 0 target)
            list(GET fields 1 old)
            get_filename_component(filename "${old}" NAME)
            set(next "${stage}/native/${filename}")
            get_target_property(directory ${target} SOURCE_DIR)
            foreach(property INCLUDE_DIRECTORIES COMPILE_OPTIONS COMPILE_DEFINITIONS)
                get_property(defined SOURCE "${old}" DIRECTORY "${directory}" PROPERTY ${property} SET)
                if(defined)
                    get_property(value SOURCE "${old}" DIRECTORY "${directory}" PROPERTY ${property})
                    set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY ${property} "${value}")
                endif()
            endforeach()
            get_filename_component(prior "${old}" DIRECTORY)
            get_property(includes SOURCE "${next}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES)
            set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES "${stage}/native;${prior};${includes}")
            if(MSVC AND filename STREQUAL "runtime_legacy_mods.cpp")
                # Native fail/termination must unwind to the existing owned
                # boundary even though these particular imports have C linkage.
                set_property(SOURCE "${next}" DIRECTORY "${directory}" APPEND PROPERTY COMPILE_OPTIONS /EHs /EHc-)
            endif()
            get_target_property(sources ${target} SOURCES)
            list(REMOVE_ITEM sources "${old}")
            list(APPEND sources "${next}")
            set_property(TARGET ${target} PROPERTY SOURCES "${sources}")
        endforeach()
        # Include the new sidecar/checkpoint and guest hooks in the portable
        # rollback contract. Never hash local build paths into a peer ID.
        set(ledger "custom-cars-adapter-2\n")
        foreach(path IN LISTS authored)
            file(RELATIVE_PATH name "${auth}" "${path}")
            file(SHA256 "${path}" hash)
            string(APPEND ledger "${name}:${hash}\n")
        endforeach()
        foreach(name pipeline.py online_pipeline.py music_pipeline.py guest_pipeline.py)
            file(SHA256 "${auth}/${name}" hash)
            string(APPEND ledger "${name}:${hash}\n")
        endforeach()
        # The existing test-build ledger also owns the new first-party math
        # and draw-sample code. These are not local settings or asset bytes.
        foreach(name lighting.hpp capture.hpp check.hpp road_wheels.h road_wheels.hpp)
            file(SHA256 "${DKRPORT_ROOT}/runtime-recomp/src/game/vehicle_lighting/${name}" hash)
            string(APPEND ledger "vehicle_lighting/${name}:${hash}\n")
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
                "${DKRPORT_ROOT}/runtime-recomp/src/game/vehicle_lighting/${name}")
        endforeach()
        get_target_property(definitions DKRExperimentalOwnedRegistry COMPILE_DEFINITIONS)
        set(next_definitions "")
        set(contracts "{")
        set(separator "")
        foreach(value IN LISTS definitions)
            if(value MATCHES "^DKR_OWNED_BUILD_ID_V(77|80)=\"([a-f0-9]+)\"$")
                set(revision "${CMAKE_MATCH_1}")
                set(previous "${CMAKE_MATCH_2}")
                string(SHA256 hash "${previous}\n${ledger}")
                set(value "DKR_OWNED_BUILD_ID_V${revision}=\"${hash}\"")
                string(APPEND contracts "${separator}\"${revision}\":\"${hash}\"")
                set(separator ",")
            endif()
            list(APPEND next_definitions "${value}")
        endforeach()
        string(APPEND contracts "}\n")
        if(separator STREQUAL "")
            message(FATAL_ERROR "Custom cars could not extend the rollback engine contract")
        endif()
        set_property(TARGET DKRExperimentalOwnedRegistry PROPERTY COMPILE_DEFINITIONS "${next_definitions}")
        file(WRITE "${stage}/vehicle-contracts.json" "${contracts}")
        if(DKR_RELEASE_EVIDENCE)
            file(WRITE "${DKR_RELEASE_EVIDENCE}/DKRExperimentalOwnedRegistry-COMPILE_DEFINITIONS.txt" "${next_definitions}\n")
        endif()
        # Re-read after the runtime replacement so the UI swap preserves it.
        get_target_property(game_sources DKRPortGame SOURCES)
        get_target_property(directory DKRPortGame SOURCE_DIR)
        set(next "${stage}/native/runtime_ui.cpp")
        foreach(property INCLUDE_DIRECTORIES COMPILE_OPTIONS COMPILE_DEFINITIONS)
            get_property(defined SOURCE "${ui}" DIRECTORY "${directory}" PROPERTY ${property} SET)
            if(defined)
                get_property(value SOURCE "${ui}" DIRECTORY "${directory}" PROPERTY ${property})
                set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY ${property} "${value}")
            endif()
        endforeach()
        get_filename_component(prior "${ui}" DIRECTORY)
        get_property(includes SOURCE "${next}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES)
        set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES "${stage}/native;${prior};${includes}")
        list(REMOVE_ITEM game_sources "${ui}")
        list(APPEND game_sources "${next}")
        set_property(TARGET DKRPortGame PROPERTY SOURCES "${game_sources}")
        foreach(target DKRRecompiledFuncsV77 DKRRecompiledFuncsV80 DKRExperimentalOwnedGameV77 DKRExperimentalOwnedGameV80)
            if(NOT TARGET ${target})
                continue()
            endif()
            get_target_property(sources ${target} SOURCES)
            set(json "[")
            set(separator "")
            foreach(path IN LISTS sources)
                if(path MATCHES "\\.c$")
                    file(TO_CMAKE_PATH "${path}" path)
                    string(APPEND json "${separator}\"${path}\"")
                    set(separator ",")
                endif()
            endforeach()
            string(APPEND json "]")
            file(WRITE "${stage}/${target}-inputs.json" "${json}")
            execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${auth}/guest_pipeline.py"
                --sources "${stage}/${target}-inputs.json" --output "${stage}/${target}"
                RESULT_VARIABLE guest_result)
            if(NOT guest_result EQUAL 0)
                message(FATAL_ERROR "Vehicle guest composition failed for ${target}")
            endif()
            file(READ "${stage}/${target}/swaps.json" swaps)
            string(JSON count LENGTH "${swaps}")
            math(EXPR last "${count}-1")
            get_target_property(directory ${target} SOURCE_DIR)
            foreach(index RANGE ${last})
                string(JSON old GET "${swaps}" ${index} old)
                string(JSON next GET "${swaps}" ${index} new)
                file(TO_CMAKE_PATH "${old}" old)
                file(TO_CMAKE_PATH "${next}" next)
                foreach(property INCLUDE_DIRECTORIES COMPILE_OPTIONS COMPILE_DEFINITIONS)
                    get_property(defined SOURCE "${old}" DIRECTORY "${directory}" PROPERTY ${property} SET)
                    if(defined)
                        get_property(value SOURCE "${old}" DIRECTORY "${directory}" PROPERTY ${property})
                        set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY ${property} "${value}")
                    endif()
                endforeach()
                get_filename_component(prior "${old}" DIRECTORY)
                set_property(SOURCE "${next}" DIRECTORY "${directory}" APPEND PROPERTY INCLUDE_DIRECTORIES "${prior}")
                list(REMOVE_ITEM sources "${old}")
                list(APPEND sources "${next}")
            endforeach()
            set_property(TARGET ${target} PROPERTY SOURCES "${sources}")
        endforeach()
    endfunction()
    cmake_language(DEFER CALL dkr_apply_custom_vehicles)
endif()
