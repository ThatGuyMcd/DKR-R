include("${CMAKE_CURRENT_LIST_DIR}/../vanilla-water/NativeOverlay.cmake")
if(PROJECT_NAME STREQUAL "DKRRuntimePreparation")
    function(dkr_apply_viewport_flow)
        execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${DKRPORT_ROOT}/patches/viewport-flow/pipeline.py"
            verify --output "${DKR_VIEWPORT_FLOW_STAGE}" RESULT_VARIABLE status)
        if(NOT status EQUAL 0)
            message(FATAL_ERROR "Viewport/flow Patch Pipeline receipt failed")
        endif()
        get_target_property(sources DKRPortGame SOURCES)
        set(replaced)
        set(count 0)
        foreach(source IN LISTS sources)
            if(source MATCHES "/f3ddkr_rt64\\.cpp$")
                math(EXPR count "${count}+1")
                set(next "${DKR_VIEWPORT_FLOW_STAGE}/native/f3ddkr_rt64.cpp")
                foreach(property INCLUDE_DIRECTORIES COMPILE_OPTIONS COMPILE_DEFINITIONS)
                    get_property(defined SOURCE "${source}" PROPERTY ${property} SET)
                    if(defined)
                        get_property(value SOURCE "${source}" PROPERTY ${property})
                        set_property(SOURCE "${next}" PROPERTY ${property} "${value}")
                    endif()
                endforeach()
                get_filename_component(prior "${source}" DIRECTORY)
                set_property(SOURCE "${next}" APPEND PROPERTY INCLUDE_DIRECTORIES "${prior}")
                list(APPEND replaced "${next}")
            else()
                list(APPEND replaced "${source}")
            endif()
        endforeach()
        if(NOT count EQUAL 1)
            message(FATAL_ERROR "Expected one first-party graphics decoder")
        endif()
        set_property(TARGET DKRPortGame PROPERTY SOURCES "${replaced}")
        message(STATUS "Viewport/flow: stable authored water batches; presentation-only fixes")
    endfunction()
    cmake_language(DEFER CALL dkr_apply_viewport_flow)
endif()
