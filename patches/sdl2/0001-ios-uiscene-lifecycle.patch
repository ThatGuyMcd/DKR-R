+static UIWindowScene *sdl_window_scene API_AVAILABLE(ios(13.0), tvos(13.0)) = nil;
+
+UIWindowScene *UIKit_GetWindowScene(void)
+{
+    return sdl_window_scene;
+}
+
+#if !TARGET_OS_TV
+extern void SDL_OnApplicationDidChangeStatusBarOrientation(void);
+
+UIInterfaceOrientation UIKit_GetInterfaceOrientation(void)
+{
+    if (@available(iOS 13.0, *)) {
+        if (sdl_window_scene != nil && sdl_window_scene.interfaceOrientation != UIInterfaceOrientationUnknown) {
+            return sdl_window_scene.interfaceOrientation;
+        }
+    }
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+    return [UIApplication sharedApplication].statusBarOrientation;
+#pragma clang diagnostic pop
+}
+#endif
+
+static void UIKit_AttachWindowToScene(UIWindow *window, UIWindowScene *scene) API_AVAILABLE(ios(13.0), tvos(13.0))
+{
+    if (window != nil && scene != nil && window.windowScene == nil) {
+        window.windowScene = scene;
+    }
+}
+
+API_AVAILABLE(ios(13.0), tvos(13.0))
+@interface SDLUIKitSceneDelegate : UIResponder <UIWindowSceneDelegate>
+@end
+
+@implementation SDLUIKitSceneDelegate
+
+- (void)scene:(UIScene *)scene willConnectToSession:(UISceneSession *)session options:(UISceneConnectionOptions *)connectionOptions
+{
+    if (![scene isKindOfClass:[UIWindowScene class]]) {
+        return;
+    }
+    sdl_window_scene = (UIWindowScene *)scene;
+
+    SDLUIKitDelegate *delegate = [SDLUIKitDelegate sharedAppDelegate];
+    [delegate attachWindowsToScene:sdl_window_scene];
+
+#if !TARGET_OS_TV
+    SDL_OnApplicationDidChangeStatusBarOrientation();
+#endif
+
+    /* A file opened from another app can be what launched us. */
+    for (UIOpenURLContext *context in connectionOptions.URLContexts) {
+        [delegate sendDropFileForURL:context.URL];
+    }
+}
+
+#if !TARGET_OS_TV
+- (void)windowScene:(UIWindowScene *)windowScene didUpdateCoordinateSpace:(id<UICoordinateSpace>)previousCoordinateSpace interfaceOrientation:(UIInterfaceOrientation)previousInterfaceOrientation traitCollection:(UITraitCollection *)previousTraitCollection
+{
+    /* Scene apps don't reliably get the status bar orientation notification,
+     * and SDL restores fullscreen windows to the desktop mode it maintains. */
+    if (windowScene == sdl_window_scene) {
+        SDL_OnApplicationDidChangeStatusBarOrientation();
+    }
+}
+#endif
+
+- (void)sceneDidDisconnect:(UIScene *)scene
+{
+    if (scene == sdl_window_scene) {
+        sdl_window_scene = nil;
+    }
+}
+
+- (void)scene:(UIScene *)scene openURLContexts:(NSSet<UIOpenURLContext *> *)URLContexts
+{
+    SDLUIKitDelegate *delegate = [SDLUIKitDelegate sharedAppDelegate];
+    for (UIOpenURLContext *context in URLContexts) {
+        [delegate sendDropFileForURL:context.URL];
+    }
+}
+
+@end
+
 @implementation SDLUIKitDelegate {
     UIWindow *launchWindow;
 }
 
+- (UISceneConfiguration *)application:(UIApplication *)application configurationForConnectingSceneSession:(UISceneSession *)connectingSceneSession options:(UISceneConnectionOptions *)options API_AVAILABLE(ios(13.0), tvos(13.0))
+{
+    UISceneConfiguration *config = [[UISceneConfiguration alloc] initWithName:nil sessionRole:connectingSceneSession.role];
+    config.delegateClass = [SDLUIKitSceneDelegate class];
+    return config;
+}
+
+- (void)attachWindowsToScene:(UIWindowScene *)scene API_AVAILABLE(ios(13.0), tvos(13.0))
+{
+    UIKit_AttachWindowToScene(launchWindow, scene);
+
+    SDL_VideoDevice *_this = SDL_GetVideoDevice();
+    if (_this) {
+        SDL_Window *window;
+        for (window = _this->windows; window != NULL; window = window->next) {
+            SDL_WindowData *data = (__bridge SDL_WindowData *) window->driverdata;
+            if (data != nil) {
+                UIKit_AttachWindowToScene(data.uiwindow, scene);
+            }
+        }
+    }
+}
