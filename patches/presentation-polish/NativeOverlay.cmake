include("${CMAKE_CURRENT_LIST_DIR}/../credits-viewport/NativeOverlay.cmake")
if(PROJECT_NAME STREQUAL "DKRRuntimePreparation")
    function(dkr_apply_presentation_polish)
        execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${DKRPORT_ROOT}/patches/presentation-polish/pipeline.py"
            verify --output "${DKR_PRESENTATION_POLISH_STAGE}" RESULT_VARIABLE status)
        if(NOT status EQUAL 0)
            message(FATAL_ERROR "Presentation Patch Pipeline receipt failed")
        endif()
        get_target_property(sources DKRPortGame SOURCES)
        set(replaced)
        set(count 0)
        foreach(source IN LISTS sources)
            if(source MATCHES "/(f3ddkr_rt64|rt64_renderer)\\.cpp$")
                math(EXPR count "${count}+1")
                get_filename_component(filename "${source}" NAME)
                set(next "${DKR_PRESENTATION_POLISH_STAGE}/native/${filename}")
                foreach(property INCLUDE_DIRECTORIES COMPILE_OPTIONS COMPILE_DEFINITIONS)
                    get_property(defined SOURCE "${source}" PROPERTY ${property} SET)
                    if(defined)
                        get_property(value SOURCE "${source}" PROPERTY ${property})
                        set_property(SOURCE "${next}" PROPERTY ${property} "${value}")
                    endif()
                endforeach()
                get_filename_component(prior "${source}" DIRECTORY)
                set_property(SOURCE "${next}" APPEND PROPERTY INCLUDE_DIRECTORIES "${prior}")
                list(APPEND replaced "${next}")
            else()
                list(APPEND replaced "${source}")
            endif()
        endforeach()
        if(NOT count EQUAL 2)
            message(FATAL_ERROR "Expected first-party decoder and renderer")
        endif()
        set_property(TARGET DKRPortGame PROPERTY SOURCES "${replaced}")
        # A single frozen build-copy translation unit hosts DKR's optional mip
        # extension. Override its authored hook, never the checked-out library.
        get_target_property(renderer_sources rt64 SOURCES)
        get_target_property(renderer_directory rt64 SOURCE_DIR)
        set(renderer_replaced)
        set(renderer_count 0)
        foreach(source IN LISTS renderer_sources)
            if(source MATCHES "/rt64_texture_cache\\.cpp$")
                math(EXPR renderer_count "${renderer_count}+1")
                set(next "${DKR_PRESENTATION_POLISH_STAGE}/renderer/rt64_texture_cache.cpp")
                foreach(property INCLUDE_DIRECTORIES COMPILE_OPTIONS COMPILE_DEFINITIONS)
                    get_property(defined SOURCE "${source}" DIRECTORY "${renderer_directory}" PROPERTY ${property} SET)
                    if(defined)
                        get_property(value SOURCE "${source}" DIRECTORY "${renderer_directory}" PROPERTY ${property})
                        set_property(SOURCE "${next}" DIRECTORY "${renderer_directory}" PROPERTY ${property} "${value}")
                    endif()
                endforeach()
                get_filename_component(prior "${source}" DIRECTORY)
                get_property(includes SOURCE "${next}" DIRECTORY "${renderer_directory}" PROPERTY INCLUDE_DIRECTORIES)
                set_property(SOURCE "${next}" DIRECTORY "${renderer_directory}" PROPERTY INCLUDE_DIRECTORIES "${prior};${includes}")
                list(APPEND renderer_replaced "${next}")
            else()
                list(APPEND renderer_replaced "${source}")
            endif()
        endforeach()
        if(NOT renderer_count EQUAL 1)
            message(FATAL_ERROR "Expected one frozen texture cache input")
        endif()
        set_property(TARGET rt64 PROPERTY SOURCES "${renderer_replaced}")
        message(STATUS "Presentation polish: intro caption/sky, fade coverage, original-water residency")
    endfunction()
    cmake_language(DEFER CALL dkr_apply_presentation_polish)
endif()
