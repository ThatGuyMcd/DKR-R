include("${CMAKE_CURRENT_LIST_DIR}/../texture-dumping/ReleaseOverlay.cmake")
if(PROJECT_NAME STREQUAL "DKRRuntimePreparation")
 function(dkr_apply_achievements)
  set(auth "${DKRPORT_ROOT}/patches/achievements")
  set(stage "${CMAKE_BINARY_DIR}/generated/achievements")
  file(MAKE_DIRECTORY "${stage}")
  set(records "[")
  set(separator "")
  foreach(pair "DKRPortGame|runtime_ui.cpp" "DKRPortGame|runtime_legacy_mods.cpp" "DKRPortGame|game_main.cpp" "DKRPortGame|experimental_runtime.cpp" "DKRExperimentalOwnedGameV77|probe_driver.cpp" "DKRExperimentalOwnedGameV80|probe_driver.cpp")
   string(REPLACE "|" ";" fields "${pair}")
   list(GET fields 0 target)
   list(GET fields 1 name)
   get_target_property(paths ${target} SOURCES)
   list(FILTER paths INCLUDE REGEX "[/\\\\]${name}$")
   list(LENGTH paths count)
   if(NOT count EQUAL 1)
    message(FATAL_ERROR "Achievements need one final ${target}/${name}")
   endif()
   list(GET paths 0 path)
   file(TO_CMAKE_PATH "${path}" path)
   string(APPEND records "${separator}{\"target\":\"${target}\",\"path\":\"${path}\"}")
   set(separator ",")
  endforeach()
  foreach(target DKRRecompiledFuncsV77 DKRRecompiledFuncsV80)
   get_target_property(paths ${target} SOURCES)
   foreach(path IN LISTS paths)
    if(path MATCHES "\\.c$")
     file(TO_CMAKE_PATH "${path}" path)
     string(APPEND records "${separator}{\"target\":\"${target}\",\"path\":\"${path}\",\"guest\":true}")
     set(separator ",")
    endif()
   endforeach()
  endforeach()
  string(APPEND records "]")
  file(WRITE "${stage}/inputs.json" "${records}")
  file(GLOB authored CONFIGURE_DEPENDS "${auth}/native/*")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${authored} "${auth}/pipeline.py")
  execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${auth}/pipeline.py" --inputs "${stage}/inputs.json" --output "${stage}" RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
   message(FATAL_ERROR "Achievement staging failed")
  endif()
  file(READ "${stage}/achievement-swaps.json" swaps)
  string(JSON count LENGTH "${swaps}")
  math(EXPR last "${count}-1")
  foreach(index RANGE ${last})
   string(JSON target GET "${swaps}" ${index} target)
   string(JSON old GET "${swaps}" ${index} path)
   string(JSON next GET "${swaps}" ${index} new)
   get_target_property(directory ${target} SOURCE_DIR)
   foreach(property INCLUDE_DIRECTORIES COMPILE_OPTIONS COMPILE_DEFINITIONS)
    get_property(defined SOURCE "${old}" DIRECTORY "${directory}" PROPERTY ${property} SET)
    if(defined)
     get_property(value SOURCE "${old}" DIRECTORY "${directory}" PROPERTY ${property})
     set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY ${property} "${value}")
    endif()
   endforeach()
   get_filename_component(prior "${old}" DIRECTORY)
   get_property(includes SOURCE "${next}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES)
   set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES "${stage};${prior};${prior}/..;${includes}")
   dkr_repair_replace_source(${target} "${old}" "${next}")
  endforeach()
  target_sources(DKRPortGame PRIVATE "${stage}/achievements.cpp" "${stage}/achievement_catalogue.cpp")
  target_include_directories(DKRPortGame PRIVATE "${stage}")
  # Host-only observations do not modify checkpoint schemas, effect journals,
  # simulation state or peer IDs. Both original guest revisions stay read-only.
 endfunction()
 cmake_language(DEFER CALL dkr_apply_achievements)
endif()
