include("${CMAKE_CURRENT_LIST_DIR}/../scene-preparation/ReleaseOverlay.cmake")
if(PROJECT_NAME STREQUAL "DKRRuntimePreparation")
 function(dkr_apply_spectators)
  set(auth "${DKRPORT_ROOT}/patches/spectators")
  set(stage "${CMAKE_BINARY_DIR}/generated/spectators")
  file(MAKE_DIRECTORY "${stage}")
  set(rows "[")
  set(separator "")
  foreach(target DKRNetplayCore DKRPortGame DKRExperimentalOwnedGameV77 DKRExperimentalOwnedGameV80 DKRCameraPresentation)
   get_target_property(paths ${target} SOURCES)
   foreach(path IN LISTS paths)
    if(path MATCHES "[.]cpp$")
     file(TO_CMAKE_PATH "${path}" path)
     string(APPEND rows "${separator}{\"target\":\"${target}\",\"path\":\"${path}\"}")
     set(separator ",")
    endif()
   endforeach()
  endforeach()
  string(APPEND rows "]")
  file(WRITE "${stage}/inputs.json" "${rows}")
  file(GLOB authored CONFIGURE_DEPENDS "${auth}/native/*")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${authored} "${auth}/pipeline.py" "${auth}/link_pipeline.py" "${auth}/owned_pipeline.py" "${auth}/runtime_pipeline.py" "${auth}/ui_pipeline.py")
  execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${auth}/pipeline.py" --inputs "${stage}/inputs.json" --output "${stage}" RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
   message(FATAL_ERROR "Spectator confirmed stream staging failed")
  endif()
  file(READ "${stage}/swaps.json" swaps)
  string(JSON count LENGTH "${swaps}")
  math(EXPR last "${count}-1")
  foreach(index RANGE ${last})
   string(JSON target GET "${swaps}" ${index} target)
   string(JSON old GET "${swaps}" ${index} path)
   string(JSON next GET "${swaps}" ${index} new)
   file(TO_CMAKE_PATH "${old}" old)
   file(TO_CMAKE_PATH "${next}" next)
   get_target_property(directory ${target} SOURCE_DIR)
   foreach(property INCLUDE_DIRECTORIES COMPILE_OPTIONS COMPILE_DEFINITIONS)
    get_property(defined SOURCE "${old}" DIRECTORY "${directory}" PROPERTY ${property} SET)
    if(defined)
     get_property(value SOURCE "${old}" DIRECTORY "${directory}" PROPERTY ${property})
     set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY ${property} "${value}")
    endif()
   endforeach()
   get_filename_component(prior "${old}" DIRECTORY)
   get_property(includes SOURCE "${next}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES)
   set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES "${stage};${prior};${includes}")
   dkr_repair_replace_source(${target} "${old}" "${next}")
  endforeach()
  foreach(name party confirmed_feed party_codec checkpoint_transfer observer_playback confirmed_observer owner_export party_link owned_observer)
   target_sources(DKRNetplayCore PRIVATE "${stage}/${name}.cpp")
  endforeach()
  target_include_directories(DKRNetplayCore PRIVATE "${stage}")
  target_include_directories(DKRPortGame PRIVATE "${stage}")
  target_sources(DKRPortGame PRIVATE "${stage}/party_runtime.cpp")
  target_include_directories(DKRCameraPresentation PRIVATE "${stage}")
  target_include_directories(DKRExperimentalOwnedGameV77 PRIVATE "${stage}")
  target_include_directories(DKRExperimentalOwnedGameV80 PRIVATE "${stage}")
  if(DKR_RELEASE_EVIDENCE)
   get_target_property(paths DKRNetplayCore SOURCES)
   file(WRITE "${DKR_RELEASE_EVIDENCE}/DKRNetplayCore-SOURCES.txt" "${paths}\n")
  endif()
 endfunction()
 cmake_language(DEFER CALL dkr_apply_spectators)
endif()
