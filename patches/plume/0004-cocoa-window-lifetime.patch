     class CocoaWindow {
+        // The attribute and refresh rate updates run as blocks on the main queue
+        // and can still be queued when the owner of this object destroys it (the
+        // render thread tears the swap chain down while the main thread is not
+        // pumping). A block holds this record instead of a bare pointer, takes its
+        // mutex, and does nothing once the destructor has cleared owner.
+        struct Lifetime {
+            std::mutex mutex;
+            CocoaWindow* owner;
+        };
+        std::shared_ptr<Lifetime> lifetime;
         void* windowHandle;
         CocoaWindowAttributes cachedAttributes;
         std::atomic<int> cachedRefreshRate;
