include("${CMAKE_CURRENT_LIST_DIR}/../achievements/ReleaseOverlay.cmake")
if(PROJECT_NAME STREQUAL "DKRRuntimePreparation")
 function(dkr_apply_all_player_detail)
  set(auth "${DKRPORT_ROOT}/patches/all-player-detail")
  set(stage "${CMAKE_BINARY_DIR}/generated/all-player-detail")
  file(MAKE_DIRECTORY "${stage}")
  set(records "[")
  set(separator "")
  foreach(pair "DKRPortGame|presentation_identity.cpp" "DKRPortGame|runtime_enhancements.cpp" "DKRPortGame|rt64_renderer.cpp" "DKRPortGame|local_model_rt64.cpp" "DKRPortGame|vehicle_rt64.cpp" "DKRPortGame|f3ddkr_rt64.cpp" "DKRPortGame|runtime_ui.cpp" "DKRLocalModelV77|visual_model_kernel.c" "DKRLocalModelV80|visual_model_kernel.c" "DKRExperimentalOwnedGameV77|probe_native.c" "DKRExperimentalOwnedGameV80|probe_native.c")
   string(REPLACE "|" ";" fields "${pair}")
   list(GET fields 0 target)
   list(GET fields 1 name)
   get_target_property(paths ${target} SOURCES)
   list(FILTER paths INCLUDE REGEX "[/\\\\]${name}$")
   list(LENGTH paths count)
   if(NOT count EQUAL 1)
    message(FATAL_ERROR "All-player detail needs one final ${target}/${name}")
   endif()
   list(GET paths 0 path)
   file(TO_CMAKE_PATH "${path}" path)
   set(extra "")
   if(name STREQUAL "runtime_ui.cpp")
    get_target_property(directory ${target} SOURCE_DIR)
    get_filename_component(parent "${path}" DIRECTORY)
    get_property(source_includes SOURCE "${path}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES)
    get_target_property(target_includes ${target} INCLUDE_DIRECTORIES)
    set(graphics "")
    foreach(candidate IN ITEMS "${parent}" ${source_includes} ${target_includes})
     if(EXISTS "${candidate}/runtime_graphics_ui.inl")
      file(TO_CMAKE_PATH "${candidate}/runtime_graphics_ui.inl" graphics)
      break()
     endif()
    endforeach()
    if(NOT graphics)
     message(FATAL_ERROR "Cannot resolve the existing graphics UI include")
    endif()
    set(extra ",\"graphics\":\"${graphics}\"")
   elseif(name STREQUAL "f3ddkr_rt64.cpp")
    file(TO_CMAKE_PATH "${DKR_LIQUID_STREAMING_STAGE}/native/enhanced_water_rt64.hpp" water_header)
    if(NOT EXISTS "${water_header}")
     message(FATAL_ERROR "Cannot resolve the existing water material header")
    endif()
    set(extra ",\"water_header\":\"${water_header}\"")
   endif()
   string(APPEND records "${separator}{\"target\":\"${target}\",\"path\":\"${path}\"${extra}}")
   set(separator ",")
  endforeach()
  foreach(target DKRRecompiledFuncsV77 DKRRecompiledFuncsV80 DKRExperimentalOwnedGameV77 DKRExperimentalOwnedGameV80)
   get_target_property(paths ${target} SOURCES)
   foreach(path IN LISTS paths)
    if(path MATCHES "\\.c$")
     file(TO_CMAKE_PATH "${path}" path)
     string(APPEND records "${separator}{\"target\":\"${target}\",\"path\":\"${path}\",\"guest\":true}")
     set(separator ",")
    endif()
   endforeach()
  endforeach()
  string(APPEND records "]")
  file(WRITE "${stage}/inputs.json" "${records}")
  file(GLOB authored CONFIGURE_DEPENDS "${auth}/native/*")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${authored} "${auth}/pipeline.py")
  execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${auth}/pipeline.py" --inputs "${stage}/inputs.json" --output "${stage}" RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
   message(FATAL_ERROR "All-player detail staging failed")
  endif()
  file(READ "${stage}/swaps.json" swaps)
  string(JSON count LENGTH "${swaps}")
  math(EXPR last "${count}-1")
  foreach(index RANGE ${last})
   string(JSON target GET "${swaps}" ${index} target)
   string(JSON old GET "${swaps}" ${index} path)
   string(JSON next GET "${swaps}" ${index} new)
   get_target_property(directory ${target} SOURCE_DIR)
   foreach(property INCLUDE_DIRECTORIES COMPILE_OPTIONS COMPILE_DEFINITIONS)
    get_property(defined SOURCE "${old}" DIRECTORY "${directory}" PROPERTY ${property} SET)
    if(defined)
     get_property(value SOURCE "${old}" DIRECTORY "${directory}" PROPERTY ${property})
     set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY ${property} "${value}")
    endif()
   endforeach()
   get_filename_component(prior "${old}" DIRECTORY)
   get_property(includes SOURCE "${next}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES)
   set_property(SOURCE "${next}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES "${stage};${prior};${prior}/..;${includes}")
   dkr_repair_replace_source(${target} "${old}" "${next}")
  endforeach()
  target_include_directories(DKRPortGame PRIVATE "${stage}")
  # Residency changes are identical on every peer; graphics remain local.
  set(ledger "all-player-detail-v1\n")
  foreach(name pipeline.py ReleaseOverlay.cmake)
   file(SHA256 "${auth}/${name}" hash)
   string(APPEND ledger "${name}:${hash}\n")
  endforeach()
  get_target_property(definitions DKRExperimentalOwnedRegistry COMPILE_DEFINITIONS)
  set(updated "")
  set(contracts "{")
  set(separator "")
  foreach(value IN LISTS definitions)
   if(value MATCHES "^DKR_OWNED_BUILD_ID_V(77|80)=\"([a-f0-9]+)\"$")
    set(revision "${CMAKE_MATCH_1}")
    string(SHA256 hash "${CMAKE_MATCH_2}\n${ledger}")
    set(value "DKR_OWNED_BUILD_ID_V${revision}=\"${hash}\"")
    string(APPEND contracts "${separator}\"${revision}\":\"${hash}\"")
    set(separator ",")
   endif()
   list(APPEND updated "${value}")
  endforeach()
  if(separator STREQUAL "")
   message(FATAL_ERROR "Missing detail peer contract")
  endif()
  string(APPEND contracts "}")
  file(WRITE "${stage}/contracts.json" "${contracts}")
  set_property(TARGET DKRExperimentalOwnedRegistry PROPERTY COMPILE_DEFINITIONS "${updated}")
  if(DKR_RELEASE_EVIDENCE)
   file(WRITE "${DKR_RELEASE_EVIDENCE}/DKRExperimentalOwnedRegistry-COMPILE_DEFINITIONS.txt" "${updated}\n")
  endif()
 endfunction()
 cmake_language(DEFER CALL dkr_apply_all_player_detail)
endif()
