include("${CMAKE_CURRENT_LIST_DIR}/../race-release-repair/ReleaseOverlay.cmake")
if(PROJECT_NAME STREQUAL "DKRRuntimePreparation")
 function(dkr_apply_offline_retention_repair)
  set(auth "${DKRPORT_ROOT}/patches/offline-retention-repair")
  set(stage "${CMAKE_BINARY_DIR}/generated/offline-retention-repair")
  file(MAKE_DIRECTORY "${stage}")
  get_target_property(paths DKRLegacyImportLibrary SOURCES)
  list(FILTER paths INCLUDE REGEX "[/\\]online_mod_profile[.]cpp$")
  list(LENGTH paths count)
  if(NOT count EQUAL 1)
   message(FATAL_ERROR "Offline retention needs one final online profile source")
  endif()
  list(GET paths 0 old)
  file(TO_CMAKE_PATH "${old}" old)
  get_target_property(ui_paths DKRPortGame SOURCES)
  list(FILTER ui_paths INCLUDE REGEX "[/\\]runtime_ui[.]cpp$")
  list(LENGTH ui_paths ui_count)
  if(NOT ui_count EQUAL 1)
   message(FATAL_ERROR "Lobby tidy-up needs one final launcher source")
  endif()
  list(GET ui_paths 0 old_ui)
  file(TO_CMAKE_PATH "${old_ui}" old_ui)
  file(WRITE "${stage}/inputs.json" "[{\"target\":\"DKRLegacyImportLibrary\",\"path\":\"${old}\"},{\"target\":\"DKRPortGame\",\"path\":\"${old_ui}\"}]")
  file(GLOB authored CONFIGURE_DEPENDS "${auth}/native/*")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${authored} "${auth}/pipeline.py" "${auth}/lobby_layout.py" "${auth}/ReleaseOverlay.cmake")
  execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${auth}/pipeline.py" --inputs "${stage}/inputs.json" --output "${stage}" RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
   message(FATAL_ERROR "Offline retention could not stage")
  endif()
  get_target_property(directory DKRLegacyImportLibrary SOURCE_DIR)
  foreach(property INCLUDE_DIRECTORIES COMPILE_OPTIONS COMPILE_DEFINITIONS)
   get_property(defined SOURCE "${old}" DIRECTORY "${directory}" PROPERTY ${property} SET)
   if(defined)
    get_property(value SOURCE "${old}" DIRECTORY "${directory}" PROPERTY ${property})
    set_property(SOURCE "${stage}/online_mod_profile.cpp" DIRECTORY "${directory}" PROPERTY ${property} "${value}")
    set_property(SOURCE "${stage}/offline_keep.cpp" DIRECTORY "${directory}" PROPERTY ${property} "${value}")
   endif()
  endforeach()
  get_filename_component(prior "${old}" DIRECTORY)
  foreach(name online_mod_profile.cpp offline_keep.cpp)
   get_property(includes SOURCE "${stage}/${name}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES)
   set_property(SOURCE "${stage}/${name}" DIRECTORY "${directory}" PROPERTY INCLUDE_DIRECTORIES "${stage};${prior};${includes}")
  endforeach()
  dkr_repair_replace_source(DKRLegacyImportLibrary "${old}" "${stage}/online_mod_profile.cpp")
  target_sources(DKRLegacyImportLibrary PRIVATE "${stage}/offline_keep.cpp")
  get_target_property(ui_directory DKRPortGame SOURCE_DIR)
  foreach(property INCLUDE_DIRECTORIES COMPILE_OPTIONS COMPILE_DEFINITIONS)
   get_property(defined SOURCE "${old_ui}" DIRECTORY "${ui_directory}" PROPERTY ${property} SET)
   if(defined)
    get_property(value SOURCE "${old_ui}" DIRECTORY "${ui_directory}" PROPERTY ${property})
    set_property(SOURCE "${stage}/runtime_ui.cpp" DIRECTORY "${ui_directory}" PROPERTY ${property} "${value}")
   endif()
  endforeach()
  get_filename_component(prior_ui "${old_ui}" DIRECTORY)
  get_property(ui_includes SOURCE "${stage}/runtime_ui.cpp" DIRECTORY "${ui_directory}" PROPERTY INCLUDE_DIRECTORIES)
  set_property(SOURCE "${stage}/runtime_ui.cpp" DIRECTORY "${ui_directory}" PROPERTY INCLUDE_DIRECTORIES "${stage};${prior_ui};${ui_includes}")
  dkr_repair_replace_source(DKRPortGame "${old_ui}" "${stage}/runtime_ui.cpp")
  add_executable(DKROfflineRetentionChecks EXCLUDE_FROM_ALL "${auth}/tests/retention_tests.cpp")
  target_compile_features(DKROfflineRetentionChecks PRIVATE cxx_std_20)
  target_include_directories(DKROfflineRetentionChecks PRIVATE "${stage}" "${DKRPORT_ROOT}/runtime-recomp/src/game")
  target_link_libraries(DKROfflineRetentionChecks PRIVATE DKRLegacyImportLibrary)
  get_target_property(test_links DKRPortGame LINK_DIRECTORIES)
  if(test_links)
   target_link_directories(DKROfflineRetentionChecks PRIVATE ${test_links})
  endif()
  # Retention runs AFTER admission and changes only optional local storage.
  # It does not change simulation, wire schemas or the playtest.2 peer IDs.
 endfunction()
 cmake_language(DEFER CALL dkr_apply_offline_retention_repair)
endif()
