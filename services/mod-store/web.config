<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".xdelta"/><mimeMap fileExtension=".xdelta" mimeType="application/octet-stream"/>
      <remove fileExtension=".nrm"/><mimeMap fileExtension=".nrm" mimeType="application/octet-stream"/>
      <remove fileExtension=".dkrcode"/><mimeMap fileExtension=".dkrcode" mimeType="application/octet-stream"/>
      <remove fileExtension=".dkrmap"/><mimeMap fileExtension=".dkrmap" mimeType="application/octet-stream"/>
      <remove fileExtension=".bps"/><mimeMap fileExtension=".bps" mimeType="application/octet-stream"/>
      <remove fileExtension=".ips"/><mimeMap fileExtension=".ips" mimeType="application/octet-stream"/>
      <remove fileExtension=".rtz"/><mimeMap fileExtension=".rtz" mimeType="application/octet-stream"/>
      <remove fileExtension=".7z"/><mimeMap fileExtension=".7z" mimeType="application/x-7z-compressed"/>
    </staticContent>
  </system.webServer>
</configuration>
