include_guard(GLOBAL)
function(dkr_add_peer_relay)
    # Set here, not at file scope: the first include can come from inside
    # another function, whose scope a file-level variable would not outlive.
    get_filename_component(_dkr_relay_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
    if(TARGET datachannel AND NOT TARGET DKRWebSocketIdleTests)
        add_executable(DKRWebSocketIdleTests "${_dkr_relay_root}/tests/websocket_idle_tests.cpp")
        target_link_libraries(DKRWebSocketIdleTests PRIVATE datachannel Threads::Threads)
        target_compile_features(DKRWebSocketIdleTests PRIVATE cxx_std_20)
        if(BUILD_TESTING)
            add_test(NAME DKRWebSocketIdle COMMAND DKRWebSocketIdleTests)
            set_tests_properties(DKRWebSocketIdle PROPERTIES TIMEOUT 15)
        endif()
    endif()
    if(NOT TARGET DKRPeerRelay)
        add_library(
            DKRPeerRelay
            STATIC
            "${_dkr_relay_root}/src/game/netplay/peer_relay/core.cpp"
            "${_dkr_relay_root}/src/game/netplay/peer_relay/live_datagram.cpp"
            "${_dkr_relay_root}/src/game/netplay/peer_relay/transport.cpp"
        )
        target_compile_features(DKRPeerRelay PUBLIC cxx_std_20)
        target_include_directories(DKRPeerRelay PUBLIC "${_dkr_relay_root}/src/game")
        target_link_libraries(DKRPeerRelay PUBLIC DKRNetplayCrypto)
        if(TARGET juice)
            target_link_libraries(DKRPeerRelay PRIVATE juice)
            target_compile_definitions(DKRPeerRelay PRIVATE DKR_LIVE_DATAGRAM_ICE=1)
        endif()
        if(MSVC)
            target_compile_definitions(DKRPeerRelay PRIVATE NOMINMAX)
        endif()
        if(TARGET datachannel)
            target_link_libraries(DKRPeerRelay PRIVATE datachannel)
            target_compile_definitions(DKRPeerRelay PRIVATE DKR_NETPLAY_WEBRTC=1)
            target_include_directories(DKRPeerRelay PRIVATE "${DKR_DEPENDENCIES_DIR}/libdatachannel/deps/json/include")
        endif()
    endif()
    if(NOT TARGET DKRLiveDatagramTests)
        add_executable(DKRLiveDatagramTests "${_dkr_relay_root}/tests/live_datagram_tests.cpp")
        target_link_libraries(DKRLiveDatagramTests PRIVATE DKRPeerRelay DKRNetplayCore)
        if(TARGET juice)
            target_compile_definitions(DKRLiveDatagramTests PRIVATE DKR_TEST_LIVE_DATAGRAM_ICE=1)
        endif()
        if(BUILD_TESTING)
            add_test(NAME DKRLiveDatagram COMMAND DKRLiveDatagramTests)
        endif()
    endif()
    if(NOT TARGET DKRPeerRelayTests)
        add_executable(DKRPeerRelayTests "${_dkr_relay_root}/tests/peer_relay_tests.cpp")
        target_link_libraries(DKRPeerRelayTests PRIVATE DKRPeerRelay DKRNetplayCore)
        if(MSVC)
            target_compile_options(DKRPeerRelayTests PRIVATE /UNDEBUG)
        else()
            target_compile_options(DKRPeerRelayTests PRIVATE -UNDEBUG)
        endif()
        if(TARGET datachannel)
            target_compile_definitions(DKRPeerRelayTests PRIVATE DKR_RELAY_WITH_RTC=1)
        endif()
        if(BUILD_TESTING)
            add_test(NAME DKRPeerRelayPolicy COMMAND DKRPeerRelayTests --policy)
            add_test(NAME DKRPeerRelayUdp COMMAND DKRPeerRelayTests --udp)
            if(TARGET datachannel)
                add_test(NAME DKRPeerRelayWebRTC COMMAND DKRPeerRelayTests --rtc)
            endif()
        endif()
    endif()
    if(TARGET DKRPortGame AND NOT TARGET DKRPeerRelayNativeTests)
        add_executable(DKRPeerRelayNativeTests EXCLUDE_FROM_ALL "${_dkr_relay_root}/tests/peer_relay_native_tests.cpp")
        target_link_libraries(DKRPeerRelayNativeTests PRIVATE DKRNetplayCore)
    endif()
    if(NOT TARGET DKRPeerRelayStartupTests)
        add_executable(DKRPeerRelayStartupTests "${_dkr_relay_root}/tests/peer_relay_startup_tests.cpp")
        target_link_libraries(DKRPeerRelayStartupTests PRIVATE DKRPeerRelay DKRNetplayCore DKROnlineStabilityCore)
        if(BUILD_TESTING)
            add_test(NAME DKRPeerRelayStartup COMMAND DKRPeerRelayStartupTests)
        endif()
    endif()
endfunction()
