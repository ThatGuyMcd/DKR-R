# Contract fingerprints must be identical for the same authored/generated
# content on Windows, Android and Linux, regardless of drive, symlink or mount.
# Absolute-path GLOB order is not a portable ordering (e.g. /repo vs /mnt/g).
function(dkr_owned_content_identity output authored_root generated_root)
    set(parts "")
    foreach(input IN LISTS ARGN)
        get_filename_component(input "${input}" ABSOLUTE BASE_DIR "${authored_root}")
        file(RELATIVE_PATH relative "${generated_root}" "${input}")
        if(relative MATCHES "^\\.\\./" OR IS_ABSOLUTE "${relative}")
            file(RELATIVE_PATH relative "${authored_root}" "${input}")
            if(relative MATCHES "^\\.\\./" OR IS_ABSOLUTE "${relative}")
                file(RELATIVE_PATH sdk_relative "${authored_root}/../modding" "${input}")
                if(sdk_relative MATCHES "^reference-us-v(77|80)/game_symbols\\.inc$")
                    set(label "sdk/${sdk_relative}")
                else()
                    message(FATAL_ERROR "Owned contract input is outside its checked roots: ${input}")
                endif()
            else()
                set(label "authored/${relative}")
            endif()
        else()
            set(label "generated/${relative}")
        endif()
        # The Python guest generator writes native text newlines: CRLF on
        # Windows, LF on Linux. They compile to the same guest program. Keep
        # every token/metadata field in the identity, but canonicalise CRLF
        # for the explicitly text-only inputs. Never normalise binary data.
        get_filename_component(extension "${input}" EXT)
        if(extension MATCHES "^\\.(c|cpp|h|hpp|json|inc)$")
            file(READ "${input}" content)
            string(REPLACE "\r\n" "\n" content "${content}")
            string(SHA256 digest "${content}")
        else()
            file(SHA256 "${input}" digest)
        endif()
        list(APPEND parts "${label}:${digest}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${input}")
    endforeach()
    list(SORT parts)
    list(JOIN parts "|" result)
    set(${output} "${result}|" PARENT_SCOPE)
endfunction()
