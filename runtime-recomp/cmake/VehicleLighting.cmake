include_guard(GLOBAL)
function(dkr_add_vehicle_lighting_checks)
    if(TARGET DKRVehicleLightingTests)
        return()
    endif()
    get_filename_component(root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../.." ABSOLUTE)
    add_executable(DKRVehicleLightingTests "${root}/runtime-recomp/tests/vehicle_lighting_tests.cpp")
    target_compile_features(DKRVehicleLightingTests PRIVATE cxx_std_20)
    target_include_directories(DKRVehicleLightingTests PRIVATE "${root}/runtime-recomp/src/game")
    if(MSVC)
        target_compile_options(DKRVehicleLightingTests PRIVATE /UNDEBUG)
    else()
        target_compile_options(DKRVehicleLightingTests PRIVATE -UNDEBUG)
    endif()
    if(BUILD_TESTING)
        add_test(NAME DKRVehicleLighting COMMAND DKRVehicleLightingTests)
    endif()
    add_executable(DKRRoadWheelLightingTests "${root}/runtime-recomp/tests/road_wheel_lighting_tests.cpp")
    target_compile_features(DKRRoadWheelLightingTests PRIVATE cxx_std_20)
    target_include_directories(DKRRoadWheelLightingTests PRIVATE "${root}/runtime-recomp/src/game")
    if(MSVC)
        target_compile_options(DKRRoadWheelLightingTests PRIVATE /UNDEBUG)
    else()
        target_compile_options(DKRRoadWheelLightingTests PRIVATE -UNDEBUG)
    endif()
    if(BUILD_TESTING)
        add_test(NAME DKRRoadWheelLighting COMMAND DKRRoadWheelLightingTests)
    endif()
endfunction()
