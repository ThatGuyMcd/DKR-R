include_guard(GLOBAL)
function(dkr_add_analogue_driving_checks)
    if(TARGET DKRAnalogueDrivingTests)
        return()
    endif()
    get_filename_component(root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../.." ABSOLUTE)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${root}/runtime-recomp/tests/analogue_driving_tests.cpp"
        "${root}/runtime-recomp/tests/analogue_poll_tests.cpp"
        "${root}/runtime-recomp/tests/look_behind_tests.cpp")
    add_executable(DKRAnalogueDrivingTests "${root}/runtime-recomp/tests/analogue_driving_tests.cpp")
    get_target_property(core_includes DKRNetplayCore INCLUDE_DIRECTORIES)
    target_include_directories(DKRAnalogueDrivingTests PRIVATE
        ${core_includes} "${root}/runtime-recomp/src/game" "${root}/modding/include" "${root}/patches/camera-plus/sdk")
    target_link_libraries(DKRAnalogueDrivingTests PRIVATE DKRNetplayCore)
    target_compile_features(DKRAnalogueDrivingTests PRIVATE cxx_std_20)
    if(DKR_RUNTIME_BUILD_RT64)
        target_compile_definitions(DKRAnalogueDrivingTests PRIVATE DKR_ANALOGUE_INPUT_CODEC=1)
    endif()
    if(MSVC)
        target_compile_options(DKRAnalogueDrivingTests PRIVATE /UNDEBUG /fp:strict)
    else()
        target_compile_options(DKRAnalogueDrivingTests PRIVATE -UNDEBUG -fno-fast-math -ffp-contract=off)
    endif()
    if(BUILD_TESTING)
        add_test(NAME DKRAnalogueDriving COMMAND DKRAnalogueDrivingTests)
    endif()
    if(DKR_RUNTIME_BUILD_RT64 AND TARGET DKRPortGame)
        add_executable(DKRLookBehindTests "${root}/runtime-recomp/tests/look_behind_tests.cpp")
        target_link_libraries(DKRLookBehindTests PRIVATE DKRCameraPresentation)
        get_target_property(camera_includes DKRCameraPresentation INCLUDE_DIRECTORIES)
        target_include_directories(DKRLookBehindTests PRIVATE ${camera_includes} "${root}/runtime-recomp/src/game")
        target_compile_features(DKRLookBehindTests PRIVATE cxx_std_20)
        if(MSVC)
            target_compile_options(DKRLookBehindTests PRIVATE /UNDEBUG)
        else()
            target_compile_options(DKRLookBehindTests PRIVATE -UNDEBUG)
        endif()
        get_target_property(game_sources DKRPortGame SOURCES)
        set(input_sources)
        foreach(source IN LISTS game_sources)
            get_filename_component(filename "${source}" NAME)
            if(filename STREQUAL "runtime_input.cpp")
                list(APPEND input_sources "${source}")
            endif()
        endforeach()
        list(LENGTH input_sources input_count)
        if(NOT input_count EQUAL 1)
            message(FATAL_ERROR "Analogue checks require the actual selected input owner")
        endif()
        add_executable(DKRAnaloguePollTests "${root}/runtime-recomp/tests/analogue_poll_tests.cpp" ${input_sources})
        get_target_property(game_includes DKRPortGame INCLUDE_DIRECTORIES)
        get_target_property(game_links DKRPortGame LINK_DIRECTORIES)
        target_include_directories(DKRAnaloguePollTests PRIVATE ${game_includes} "${root}/runtime-recomp/src/game")
        if(game_links)
            target_link_directories(DKRAnaloguePollTests PRIVATE ${game_links})
            target_link_directories(DKRLookBehindTests PRIVATE ${game_links})
        endif()
        target_compile_features(DKRAnaloguePollTests PRIVATE cxx_std_20)
        target_compile_definitions(DKRAnaloguePollTests PRIVATE DKR_RUNTIME_HAS_RT64=1 NOMINMAX)
        if(TARGET SDL2::SDL2)
            target_link_libraries(DKRAnaloguePollTests PRIVATE SDL2::SDL2)
        else()
            target_link_libraries(DKRAnaloguePollTests PRIVATE SDL2)
        endif()
        if(MSVC)
            target_compile_options(DKRAnaloguePollTests PRIVATE /UNDEBUG)
            add_custom_command(TARGET DKRAnaloguePollTests POST_BUILD COMMAND "${CMAKE_COMMAND}" -E copy_if_different
                "${DKR_DEPENDENCIES_DIR}/rt64/src/contrib/mupen64plus-win32-deps/SDL2-2.26.3/lib/x64/SDL2.dll"
                "$<TARGET_FILE_DIR:DKRAnaloguePollTests>/SDL2.dll")
        else()
            target_compile_options(DKRAnaloguePollTests PRIVATE -UNDEBUG)
        endif()
        if(BUILD_TESTING)
            add_test(NAME DKRAnaloguePoll COMMAND DKRAnaloguePollTests)
        endif()
    endif()
endfunction()
