include_guard(GLOBAL)
function(dkr_add_controller_feedback_checks)
    if(TARGET DKRControllerFeedbackTests)
        return()
    endif()
    get_filename_component(root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../.." ABSOLUTE)
    add_executable(DKRControllerFeedbackTests "${root}/runtime-recomp/tests/controller_feedback_tests.cpp")
    target_include_directories(DKRControllerFeedbackTests PRIVATE "${root}/runtime-recomp/src/game")
    target_compile_features(DKRControllerFeedbackTests PRIVATE cxx_std_20)
    if(MSVC)
        target_compile_options(DKRControllerFeedbackTests PRIVATE /UNDEBUG)
    else()
        target_compile_options(DKRControllerFeedbackTests PRIVATE -UNDEBUG)
    endif()
    if(BUILD_TESTING)
        add_test(NAME DKRControllerFeedback COMMAND DKRControllerFeedbackTests)
    endif()
endfunction()
