include_guard(GLOBAL)
function(dkr_add_library_ui_checks)
    include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/CrashReports.cmake")
    dkr_add_crash_reports()
    include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/FilePicker.cmake")
    dkr_add_file_picker()
    if(TARGET DKRLibraryUiTests)
        return()
    endif()
    get_filename_component(root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../.." ABSOLUTE)
    if(TARGET DKRPortGame)
        add_executable(DKRLauncherGpuChecks EXCLUDE_FROM_ALL "${root}/runtime-recomp/tests/launcher_gpu_tests.cpp")
        target_compile_features(DKRLauncherGpuChecks PRIVATE cxx_std_20)
        get_target_property(game_includes DKRPortGame INCLUDE_DIRECTORIES)
        get_target_property(game_links DKRPortGame LINK_DIRECTORIES)
        target_include_directories(DKRLauncherGpuChecks PRIVATE ${game_includes} "${root}/runtime-recomp/src/game")
        if(game_links)
            target_link_directories(DKRLauncherGpuChecks PRIVATE ${game_links})
        endif()
        if(TARGET SDL2::SDL2)
            target_link_libraries(DKRLauncherGpuChecks PRIVATE SDL2::SDL2)
        else()
            target_link_libraries(DKRLauncherGpuChecks PRIVATE SDL2)
        endif()
    endif()
    add_executable(DKRLibraryUiTests "${root}/runtime-recomp/tests/library_ui_tests.cpp")
    target_compile_features(DKRLibraryUiTests PRIVATE cxx_std_20)
    target_include_directories(DKRLibraryUiTests PRIVATE "${root}/runtime-recomp/src/game")
    if(MSVC)
        target_compile_options(DKRLibraryUiTests PRIVATE /UNDEBUG)
    else()
        target_compile_options(DKRLibraryUiTests PRIVATE -UNDEBUG)
    endif()
    if(BUILD_TESTING)
        add_test(NAME DKRLibraryUi COMMAND DKRLibraryUiTests)
    endif()
    add_executable(DKRDisplaySessionTests "${root}/runtime-recomp/tests/display_session_tests.cpp")
    target_compile_features(DKRDisplaySessionTests PRIVATE cxx_std_20)
    target_include_directories(DKRDisplaySessionTests PRIVATE "${root}/runtime-recomp/src/game")
    if(MSVC)
        target_compile_options(DKRDisplaySessionTests PRIVATE /UNDEBUG)
    else()
        target_compile_options(DKRDisplaySessionTests PRIVATE -UNDEBUG)
    endif()
    if(BUILD_TESTING)
        add_test(NAME DKRDisplaySession COMMAND DKRDisplaySessionTests)
    endif()
    set(imgui "${root}/extern/rt64/src/contrib/imgui")
    add_executable(DKRUiSurfaceTests "${root}/runtime-recomp/tests/ui_surface_tests.cpp"
        "${imgui}/imgui.cpp" "${imgui}/imgui_draw.cpp" "${imgui}/imgui_tables.cpp" "${imgui}/imgui_widgets.cpp")
    target_compile_features(DKRUiSurfaceTests PRIVATE cxx_std_20)
    target_include_directories(DKRUiSurfaceTests PRIVATE "${root}/runtime-recomp/src/game" "${imgui}")
    if(MSVC)
        target_compile_options(DKRUiSurfaceTests PRIVATE /UNDEBUG)
    else()
        target_compile_options(DKRUiSurfaceTests PRIVATE -UNDEBUG)
    endif()
    if(BUILD_TESTING)
        add_test(NAME DKRUiSurfaces COMMAND DKRUiSurfaceTests)
    endif()
    add_executable(DKRUiFieldTests "${root}/runtime-recomp/tests/ui_field_tests.cpp"
        "${imgui}/imgui.cpp" "${imgui}/imgui_draw.cpp" "${imgui}/imgui_tables.cpp" "${imgui}/imgui_widgets.cpp")
    target_compile_features(DKRUiFieldTests PRIVATE cxx_std_20)
    target_link_libraries(DKRUiFieldTests PRIVATE DKRLocalisation)
    target_include_directories(DKRUiFieldTests PRIVATE "${root}/runtime-recomp/src/game" "${imgui}")
    if(MSVC)
        target_compile_options(DKRUiFieldTests PRIVATE /UNDEBUG)
    else()
        target_compile_options(DKRUiFieldTests PRIVATE -UNDEBUG)
    endif()
    if(BUILD_TESTING)
        add_test(NAME DKRUiFields COMMAND DKRUiFieldTests)
    endif()
endfunction()
