# Guest symbol headers: runtime-recomp/symbols/*.toml, generated by
# scripts/gen_guest_symbols.py into the build tree at configure time. Nothing
# generated is committed; the requests and the pinned symbol tables are the
# inputs.
#
#   dkr_guest_symbols(<target>)   generate and put them on the target's include path
include_guard(GLOBAL)
find_package(Python3 REQUIRED COMPONENTS Interpreter)

function(dkr_guest_symbols target)
    set(out "${CMAKE_BINARY_DIR}/generated/symbols")
    set(script "${DKRPORT_ROOT}/scripts/gen_guest_symbols.py")
    file(GLOB requests CONFIGURE_DEPENDS "${DKRPORT_ROOT}/runtime-recomp/symbols/*.toml")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${script}" ${requests})
    foreach(revision IN ITEMS 77 80)
        set_property(
            DIRECTORY
            APPEND
            PROPERTY
                CMAKE_CONFIGURE_DEPENDS
                    "${DKRPORT_ROOT}/modding/reference-us-v${revision}/data.toml"
                    "${DKRPORT_ROOT}/extern/dkr-decomp/ver/symbols/symbol_addrs.us.v${revision}.txt"
        )
    endforeach()
    execute_process(
        COMMAND "${Python3_EXECUTABLE}" "${script}" --out "${out}" ${requests}
        RESULT_VARIABLE status
    )
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Guest symbol headers could not be generated; see above")
    endif()
    target_include_directories(${target} PRIVATE "${out}")
endfunction()
