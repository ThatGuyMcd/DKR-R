include_guard(GLOBAL)
function(dkr_add_file_picker)
    if(ANDROID OR APPLE)
        return()
    endif()
    # Retained releases register new services at the existing late UI boundary,
    # after Camera++ has finished mapping its frozen historical source set.
    if(DKR_CAMERA_STAGE AND NOT TARGET DKRCameraPresentation)
        return()
    endif()
    get_filename_component(root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../.." ABSOLUTE)
    if(NOT TARGET DKRFilePickerProcess)
        add_library(DKRFilePickerProcess STATIC "${root}/runtime-recomp/src/game/file_picker/process.cpp")
        target_compile_features(DKRFilePickerProcess PUBLIC cxx_std_20)
        target_include_directories(
            DKRFilePickerProcess
            PUBLIC "${root}/runtime-recomp/src/game" "${DKR_DEPENDENCIES_DIR}/n64-modern-runtime/thirdparty"
        )
        target_link_libraries(DKRFilePickerProcess PUBLIC DKRUpdateInstall)
        if(WIN32)
            target_link_libraries(DKRFilePickerProcess PRIVATE user32)
        endif()
        if(BUILD_TESTING)
            add_executable(DKRFilePickerFake "${root}/runtime-recomp/tests/file_picker_fake.cpp")
            target_link_libraries(DKRFilePickerFake PRIVATE DKRFilePickerProcess)
            add_executable(DKRFilePickerTests "${root}/runtime-recomp/tests/file_picker_tests.cpp")
            target_link_libraries(DKRFilePickerTests PRIVATE DKRFilePickerProcess)
            add_test(NAME DKRFilePicker COMMAND DKRFilePickerTests "$<TARGET_FILE:DKRFilePickerFake>")
            if(MSVC)
                target_compile_options(DKRFilePickerFake PRIVATE /utf-8)
                target_compile_options(DKRFilePickerTests PRIVATE /utf-8)
            endif()
        endif()
    endif()
    if(TARGET DKRPortGame AND TARGET nfd AND NOT TARGET DKRFilePicker)
        add_library(DKRFilePickerClient STATIC "${root}/runtime-recomp/src/game/file_picker/client.cpp")
        target_link_libraries(DKRFilePickerClient PRIVATE DKRFilePickerProcess nfd)
        target_link_libraries(DKRPortGame PRIVATE DKRFilePickerClient)
        add_executable(DKRFilePicker "${root}/runtime-recomp/src/game/file_picker/helper.cpp")
        target_link_libraries(DKRFilePicker PRIVATE DKRFilePickerProcess nfd)
        if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
            # Keep host GTK/GIO coherent without requiring the host's C++ ABI
            # to match the compiler used for this small isolated helper.
            target_link_options(DKRFilePicker PRIVATE -static-libstdc++ -static-libgcc)
        endif()
        set_target_properties(DKRFilePicker PROPERTIES OUTPUT_NAME "DKR-R-FilePicker")
        foreach(config Debug Release RelWithDebInfo MinSizeRel)
            string(TOUPPER "${config}" upper)
            set_target_properties(
                DKRFilePicker
                PROPERTIES RUNTIME_OUTPUT_DIRECTORY_${upper} "${CMAKE_BINARY_DIR}/bin/${config}/libexec/dkr-r"
            )
        endforeach()
        add_dependencies(DKRPortGame DKRFilePicker)
    endif()
endfunction()
