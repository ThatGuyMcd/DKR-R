{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "host-base",
      "hidden": true,
      "binaryDir": "${sourceDir}/../build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "DKR_RUNTIME_BUILD_GENERATED": "OFF",
        "DKR_RUNTIME_BUILD_RT64": "OFF"
      }
    },
    {
      "name": "host",
      "displayName": "ROM-free host tests (Ninja)",
      "inherits": "host-base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "host-windows",
      "displayName": "ROM-free host tests (Visual Studio 2022)",
      "inherits": "host-base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "host-debug",
      "displayName": "Debug host tests",
      "inherits": "host",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "host-windows-debug",
      "displayName": "Debug host-windows tests",
      "inherits": "host-windows",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "host-sanitizers",
      "displayName": "ROM-free host tests with ASan and UBSan",
      "inherits": "host",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "DKR_HOST_SANITIZERS": "ON"
      }
    },
    {
      "name": "host-full-nogen",
      "displayName": "ROM-free build of every module, RT64 on, no generated payload",
      "inherits": "host",
      "cacheVariables": {
        "DKR_RUNTIME_BUILD_RT64": "ON"
      }
    },
    {
      "name": "release-base",
      "hidden": true,
      "binaryDir": "${sourceDir}/../build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "DKR_RUNTIME_BUILD_GENERATED": "ON",
        "DKR_RUNTIME_BUILD_RT64": "ON",
        "DKR_RUNTIME_BUILD_SDL3_INPUT_HOST": "ON",
        "DKR_NETPLAY_WEBRTC": "ON",
        "DKR_EXPERIMENTAL_RACE_TEST": "ON",
        "DKR_VERIFY_BUILD_INPUTS": "ON"
      }
    },
    {
      "name": "release-windows",
      "displayName": "Release build, Windows x64 (scripts/release/build.py)",
      "inherits": "release-base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "release-linux",
      "displayName": "Release build, Linux x86_64 or ARM64 (scripts/release/build.py)",
      "inherits": "release-base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "release-macos",
      "displayName": "Release build, macOS (no integrated rollback yet)",
      "inherits": "release-base",
      "generator": "Ninja",
      "cacheVariables": {
        "DKR_EXPERIMENTAL_RACE_TEST": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host",
      "configurePreset": "host",
      "configuration": "Release"
    },
    {
      "name": "host-windows",
      "configurePreset": "host-windows",
      "configuration": "Release"
    },
    {
      "name": "host-debug",
      "configurePreset": "host-debug",
      "configuration": "Debug"
    },
    {
      "name": "host-windows-debug",
      "configurePreset": "host-windows-debug",
      "configuration": "Debug"
    },
    {
      "name": "host-sanitizers",
      "configurePreset": "host-sanitizers",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "host-full-nogen",
      "configurePreset": "host-full-nogen",
      "configuration": "Release"
    },
    {
      "name": "release-windows",
      "configurePreset": "release-windows",
      "configuration": "Release"
    },
    {
      "name": "release-linux",
      "configurePreset": "release-linux",
      "configuration": "Release"
    },
    {
      "name": "release-macos",
      "configurePreset": "release-macos",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "host",
      "configurePreset": "host",
      "configuration": "Release",
      "filter": {
        "include": {
          "name": "^DKR"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "host-windows",
      "configurePreset": "host-windows",
      "configuration": "Release",
      "filter": {
        "include": {
          "name": "^DKR"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "host-debug",
      "configurePreset": "host-debug",
      "configuration": "Debug",
      "filter": {
        "include": {
          "name": "^DKR"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "host-windows-debug",
      "configurePreset": "host-windows-debug",
      "configuration": "Debug",
      "filter": {
        "include": {
          "name": "^DKR"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "host-sanitizers",
      "inherits": "host",
      "configurePreset": "host-sanitizers",
      "configuration": "RelWithDebInfo",
      "environment": {
        "ASAN_OPTIONS": "halt_on_error=1:abort_on_error=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      }
    },
    {
      "name": "host-full-nogen",
      "configurePreset": "host-full-nogen",
      "configuration": "Release",
      "filter": {
        "include": {
          "name": "^DKR"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "release-windows",
      "configurePreset": "release-windows",
      "configuration": "Release",
      "filter": {
        "include": {
          "name": "^DKR"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "release-linux",
      "configurePreset": "release-linux",
      "configuration": "Release",
      "filter": {
        "include": {
          "name": "^DKR"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "release-macos",
      "configurePreset": "release-macos",
      "configuration": "Release",
      "filter": {
        "include": {
          "name": "^DKR"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
