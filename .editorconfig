root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,h,hpp,c,cmake}]
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# shfmt reads these when run without flags. Measured against the tracked
# scripts: 2 spaces, no case indent, no -bn/-sr is the style already in use.
[*.sh]
indent_style = space
indent_size = 2
switch_case_indent = false
binary_next_line = false
space_redirects = false
