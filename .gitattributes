* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.png binary
*.ico binary
*.zip binary
# Unified diffs prefix blank context lines with a space. Do not trim their
# checksum-pinned bytes or treat nested patch syntax as source whitespace.
*.patch -whitespace
# Address-only SDK kits are checked against byte-exact receipt hashes.
# Preserve their bytes rather than applying a platform's text conversion.
modding/reference-us-v*/* -text
