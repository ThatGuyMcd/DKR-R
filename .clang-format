BasedOnStyle: LLVM
IndentWidth: 4
ColumnLimit: 120
PointerAlignment: Left
AllowShortFunctionsOnASingleLine: Empty
SortIncludes: Never  # include order is load-bearing in spliced TUs (runtime_ui.cpp)
BreakStringLiterals: false  # a split literal is a token change; formatting must not make one
SortUsingDeclarations: Never  # keep the pass layout-only (scripts/format_tokens.py)
