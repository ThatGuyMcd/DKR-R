{
  "schema_version": 1,
  "name": "Private retail CPU replay and scene regression",
  "scenarios": [
    {
      "id": "v77-owned-race",
      "description": "Owned game correction and canonical state/PCM equality",
      "command": [
        "${probe77}",
        "${race77}",
        "mode_game",
        "--offline-services",
        "--owned-adapter-check"
      ],
      "env": {
        "DKR_PROBE_ROM": "${rom77}",
        "DKR_PROBE_TEST_FRAMES": "120",
        "DKR_ROLLBACK_PROFILE": "1"
      },
      "inputs": [
        "${race77}",
        "${rom77}"
      ],
      "expect_stdout": [
        "state_pcm_exact=1 confirmed_sink_once=1 immutable_publication=1"
      ],
      "timeout_seconds": 180,
      "required_metrics": [
        "rollback.guest-tick.count",
        "rollback.guest-tick.mean_ms"
      ]
    },
    {
      "id": "v77-authored-driver",
      "description": "Authored CPU with late input and immutable presentation ownership",
      "command": [
        "${probe77}",
        "${race77}",
        "mode_game",
        "--offline-services",
        "--authored-owned-driver"
      ],
      "env": {
        "DKR_PROBE_ROM": "${rom77}",
        "DKR_PROBE_TEST_FRAMES": "120",
        "DKR_ROLLBACK_PROFILE": "1"
      },
      "inputs": [
        "${race77}",
        "${rom77}"
      ],
      "expect_stdout": [
        "PRIVATE AUTHORED MAIN CPU: exact retail CPU span",
        "players=2 frames=120",
        "players=3 frames=120",
        "players=4 frames=120",
        "exact=1; full game adapter remains unqualified"
      ],
      "timeout_seconds": 300,
      "required_metrics": [
        "rollback.guest-tick.count",
        "rollback.guest-tick.mean_ms"
      ]
    },
    {
      "id": "v77-menu-flow",
