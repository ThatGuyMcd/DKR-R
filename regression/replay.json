      "expect_stdout": [
        "Cross-platform replay v77 state=",
        "Cross-platform replay v80 state=",
        "effects-with-pcm=",
        "Both production revision engines: real gameplay corrections, exact state/PCM and interleaved replay isolation passed."
      ],
      "timeout_seconds": 300,
      "fingerprints": [
        "^Cross-platform replay v77 state=[0-9a-f]+ effects-with-pcm=[0-9a-f]+$",
        "^Cross-platform replay v80 state=[0-9a-f]+ effects-with-pcm=[0-9a-f]+$"
