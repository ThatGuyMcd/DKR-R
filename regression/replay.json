      "description": "Interleaved production revision engines restore/replay with stable state and PCM fingerprints",
      "command": [
        "${registry}",
        "${race77}",
        "${rom77}",
        "${race80}",
        "${rom80}"
      ],
      "env": {
        "DKR_ROLLBACK_PROFILE": "1"
      },
      "inputs": [
        "${race77}",
        "${rom77}",
        "${race80}",
        "${rom80}"
